@import "sa_std/vec.sa"
@import "src/tok.sla"
@import "src/ast.sla"
@import "src/value.sla"
@import "src/interp_core.sla"
@import "src/interp_expr.sla"
@import "src/interp_stmt.sla"
@import "src/builtins.sla"

impl Interp {
    fn run(&self, root: i64) -> void {
        self.init_globals();
        let e = self.new_env(-1);
        self.exec_block(e, root);
        if self.err != 0 {
            s_write(bs_str(STR_PTR("lua error (line "), 17));
            s_write(s_i64(self.curline));
            s_write(bs_str(STR_PTR("): "), 3));
            s_write(self.err);
            s_nl();
        };
    }
}
