@import "sa_std/vec.sa"
@import "sa_std/string.sa"
@import "sa_std/math.sai"
@import "src/tok.sla"
@import "src/value.sla"
@import "src/interp_core.sla"

impl Interp {
    fn arith_op_name(&self, op: i64) -> u64 {
        if op == TK_ADD {
            return s_from(STR_PTR("add"), 3);
        };
        if op == TK_SUB {
            return s_from(STR_PTR("sub"), 3);
        };
        if op == TK_MUL {
            return s_from(STR_PTR("mul"), 3);
        };
        if op == TK_DIV {
            return s_from(STR_PTR("div"), 3);
        };
        if op == TK_MOD {
            return s_from(STR_PTR("mod"), 3);
        };
        if op == TK_IDIV {
            return s_from(STR_PTR("idiv"), 4);
        };
        if op == TK_POW {
            return s_from(STR_PTR("pow"), 3);
        };
        return s_from(STR_PTR("perform arithmetic on"), 21);
    }

    fn arith_error_msg(&self, op: i64, t1: u64, t2: u64, str_mode: bool) -> u64 {
        if str_mode {
            let m1 = s_cat(s_cat(s_from(STR_PTR("attempt to "), 11), self.arith_op_name(op)), s_from(STR_PTR(" a '"), 4));
            let m2 = s_cat(s_cat(m1, t1), s_from(STR_PTR("' with a '"), 10));
            let m3 = s_cat(m2, t2);
            return s_cat(m3, s_from(STR_PTR("'"), 1));
        };
        let m4 = s_cat(s_from(STR_PTR("attempt to perform arithmetic on a "), 35), t1);
        return s_cat(m4, s_from(STR_PTR(" value"), 6));
    }

    fn mm_exists(&self, name: u64, a: Value, b: Value) -> bool {
        let ma = self.metatable_of(a);
        if ma >= 0 {
            let f = self.table_get(ma, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                return true;
            };
        };
        let mb = self.metatable_of(b);
        if mb >= 0 {
            let f = self.table_get(mb, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                return true;
            };
        };
        return false;
    }

    fn to_int_exact(&self, v: Value) -> Value {
        if v.tag == VT_INT {
            return v;
        };
        if v.tag == VT_NUM {
            let i = v.f as i64;
            if (i as f64) == v.f {
                return v_int(i);
            };
        };
        return v_nil();
    }

    fn is_bitwise_op(&self, op: i64) -> bool {
        if op == TK_AMP || op == TK_PIPE || op == TK_TILDE {
            return true;
        };
        if op == TK_SHL || op == TK_SHR {
            return true;
        };
        return false;
    }

    fn bit_error_msg(&self, a: Value, b: Value) -> u64 {
        let t1 = v_type_name(a);
        let m1 = s_cat(s_from(STR_PTR("attempt to perform bitwise operation on a "), 42), t1);
        return s_cat(m1, s_from(STR_PTR(" value"), 6));
    }

    fn num_bin(&self, op: i64, a: Value, b: Value) -> Value {
        let str_mode = a.tag == VT_STR || b.tag == VT_STR;
        let t1 = v_type_name(a);
        let t2 = v_type_name(b);
        if self.is_bitwise_op(op) {
            let ai = self.to_int_exact(a);
            let bi = self.to_int_exact(b);
            if ai.tag == VT_INT && bi.tag == VT_INT {
                return self.bitwise_op(op, ai, bi);
            };
            let mm = self.bin_mm_name(op);
            if mm != 0 {
                if self.mm_exists(mm, a, b) {
                    return self.mm_bin(mm, a, b);
                };
            };
            if a.tag == VT_NUM || b.tag == VT_NUM {
                self.fail_str(STR_PTR("number has no integer representation"), 36);
                return v_nil();
            };
            self.fail_text(self.bit_error_msg(a, b));
            return v_nil();
        };
        let oa = value_new(a.tag, a.i, a.f, a.s);
        let ob = value_new(b.tag, b.i, b.f, b.s);
        a = self.v_coerce_num(a);
        b = self.v_coerce_num(b);
        if v_is_number(a) == false || v_is_number(b) == false {
            let mm = self.bin_mm_name(op);
            if mm != 0 {
                if self.mm_exists(mm, oa, ob) {
                    return self.mm_bin(mm, oa, ob);
                };
            };
            self.fail_text(self.arith_error_msg(op, t1, t2, str_mode));
            return v_nil();
        };
        let both = a.tag == VT_INT && b.tag == VT_INT;
        if op == TK_ADD {
            if both {
                return v_int(a.i + b.i);
            };
            return v_num(v_as_num(a) + v_as_num(b));
        };
        if op == TK_SUB {
            if both {
                return v_int(a.i - b.i);
            };
            return v_num(v_as_num(a) - v_as_num(b));
        };
        if op == TK_MUL {
            if both {
                return v_int(a.i * b.i);
            };
            return v_num(v_as_num(a) * v_as_num(b));
        };
        if op == TK_DIV {
            let d = v_as_num(b);
            return v_num(v_as_num(a) / d);
        };
        if op == TK_IDIV {
            if both {
                if b.i == 0 {
                    self.fail_str(STR_PTR("attempt to divide by zero"), 25);
                    return v_nil();
                };
                if b.i == -1 {
                    return v_int(0 - a.i);
                };
                let q = a.i / b.i;
                if b.i == -1 {
                    return v_int(0);
                };
                let r = a.i % b.i;
                if r != 0 && ((r < 0) != (b.i < 0)) {
                    q = q - 1;
                };
                return v_int(q);
            };
            let d = v_as_num(b);
            return v_num(sa_math_floor(v_as_num(a) / d));
        };
        if op == TK_MOD {
            if both {
                if b.i == 0 {
                    self.fail_str(STR_PTR("attempt to perform 'n%%0'"), 25);
                    return v_nil();
                };
                let r = a.i % b.i;
                if r != 0 && ((r < 0) != (b.i < 0)) {
                    r = r + b.i;
                };
                return v_int(r);
            };
            let d = v_as_num(b);
            let r = v_as_num(a) - sa_math_floor(v_as_num(a) / d) * d;
            return v_num(r);
        };
        if op == TK_POW {
            return v_num(sa_math_pow(v_as_num(a), v_as_num(b)));
        };
        return v_nil();
    }

    fn bitwise_op(&self, op: i64, a: Value, b: Value) -> Value {
        if op == TK_AMP {
            return v_int(a.i & b.i);
        };
        if op == TK_PIPE {
            return v_int(a.i | b.i);
        };
        if op == TK_TILDE {
            return v_int(a.i ^ b.i);
        };
        let x = a.i;
        let n = b.i;
        let left = op == TK_SHL;
        if n < 0 {
            if n <= -64 {
                return v_int(0);
            };
            left = left == false;
            n = 0 - n;
        };
        if n >= 64 {
            return v_int(0);
        };
        if left {
            return v_int(((x as u64) << (n as u64)) as i64);
        };
        return v_int(((x as u64) >> (n as u64)) as i64);
    }

    fn metatable_of(&self, v: Value) -> i64 {
        if v.tag == VT_TABLE {
            return self.tables[v.i].meta;
        };
        if v.tag == VT_STR {
            let sm = self.table_get_str(self.globals, s_from(STR_PTR("__strmeta"), 9));
            if sm.tag == VT_TABLE {
                return sm.i;
            };
        };
        return self.type_meta(v_type_name(v));
    }

    fn bin_mm_name(&self, op: i64) -> u64 {
        if op == TK_ADD { return s_from(STR_PTR("__add"), 5); };
        if op == TK_SUB { return s_from(STR_PTR("__sub"), 5); };
        if op == TK_MUL { return s_from(STR_PTR("__mul"), 5); };
        if op == TK_DIV { return s_from(STR_PTR("__div"), 5); };
        if op == TK_IDIV { return s_from(STR_PTR("__idiv"), 6); };
        if op == TK_MOD { return s_from(STR_PTR("__mod"), 5); };
        if op == TK_POW { return s_from(STR_PTR("__pow"), 5); };
        if op == TK_AMP { return s_from(STR_PTR("__band"), 6); };
        if op == TK_PIPE { return s_from(STR_PTR("__bor"), 5); };
        if op == TK_TILDE { return s_from(STR_PTR("__bxor"), 6); };
        if op == TK_SHL { return s_from(STR_PTR("__shl"), 5); };
        if op == TK_SHR { return s_from(STR_PTR("__shr"), 5); };
        return 0;
    }

    fn mm_bin(&self, name: u64, a: Value, b: Value) -> Value {
        let ma = self.metatable_of(a);
        if ma >= 0 {
            let f = self.table_get(ma, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                let args = Vec::new();
                args.push(a);
                args.push(b);
                let out = self.call_value(f, args);
                if len(out) > 0 {
                    return out[0];
                };
            };
        };
        let mb = self.metatable_of(b);
        if mb >= 0 {
            let f = self.table_get(mb, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                let args = Vec::new();
                args.push(a);
                args.push(b);
                let out = self.call_value(f, args);
                if len(out) > 0 {
                    return out[0];
                };
            };
        };
        self.fail_str(STR_PTR("attempt to perform arithmetic on a non-number value"), 51);
        return v_nil();
    }

    fn mm_un(&self, name: u64, a: Value) -> Value {
        let ma = self.metatable_of(a);
        if ma >= 0 {
            let f = self.table_get(ma, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                let args = Vec::new();
                args.push(a);
                args.push(a);
                let out = self.call_value(f, args);
                if len(out) > 0 {
                    return out[0];
                };
            };
        };
        self.fail_str(STR_PTR("attempt to perform arithmetic on a non-number value"), 51);
        return v_nil();
    }
};
