@import "sa_std/vec.sa"
@import "sa_std/string.sa"
@import "sa_std/math.sai"
@import "src/value.sla"
@import "src/strutil.sla"
@import "src/interp_core.sla"
@import "src/interp_expr.sla"
@import "sa_std/fs.sai"
@import "src/libfs.sai"
@import "sa_std/fs.sa"
@import "sa_std/fmt.sai"
@import "src/lexer.sla"
@import "src/parser.sla"
@import "src/opcodes.sla"
@import "src/libutil.sla"
@import "src/libm.sai"

fn istr(s: ptr, n: u64) -> u64 {
    return s_from(s, n);
}

impl Interp {
    fn math_num(&self, args: &Vec<Value>, i: i64) -> f64 {
        let v = self.v_coerce_num(bs_arg(args, i));
        if v_is_number(v) == false {
            self.fail_str(STR_PTR("bad argument to math function (number expected)"), 47);
            return 0.0;
        };
        return v_as_num(v);
    }

    fn builtin_aux(&self, id: i64, args: &Vec<Value>) -> Vec<Value> {
        if id == B_M_FMOD {
            let a = self.math_num(args, 0);
            let b = self.math_num(args, 1);
            let q = sa_math_floor(a / b);
            return bs_one(v_num(a - q * b));
        };
        if id == B_REQUIRE {
            return self.bi_require(args);
        };
        if id == B_PKG_SEARCHPATH {
            return self.bi_searchpath(args);
        };
        if id == B_CORO_RUNNING {
            let r = Vec::new();
            r.push(v_thread(1));
            r.push(v_bool(true));
            return r;
        };
        if id == B_CORO_UNSUPPORTED {
            self.fail_str(STR_PTR("coroutine support is not implemented"), 36);
            return Vec::new();
        };
        if id == B_IO_WRITE {
            let i = 0;
            while i < (len(args) as i64) {
                s_write(v_to_string(args[i]));
                i = i + 1;
            }
            return Vec::new();
        };
        if id == B_IO_UNSUPPORTED {
            self.fail_str(STR_PTR("io library is not implemented"), 29);
            return Vec::new();
        };
        if id == B_DBG_INFO {
            return self.bi_dbg_info(args);
        };
        if id == B_DBG_TRACE {
            let m = bs_arg(args, 0);
            if m.tag == VT_NIL {
                return bs_one(v_str(bs_str(STR_PTR(""), 0)));
            };
            return bs_one(v_str(v_to_string(m)));
        };
        if id == B_T_CREATE {
            let t = self.new_table();
            let narr = 0;
            let nrec = 0;
            if len(args) > 0 {
                narr = self.bi_int(bs_arg(args, 0), 0);
            };
            if len(args) > 1 {
                nrec = self.bi_int(bs_arg(args, 1), 0);
            };
            if narr < 0 || narr > 2147483647 {
                self.fail_str(STR_PTR("bad argument #1 to 'create' (out of range)"), 42);
                return Vec::new();
            };
            if nrec < 0 || nrec > 2147483647 {
                self.fail_str(STR_PTR("bad argument #2 to 'create' (out of range)"), 42);
                return Vec::new();
            };
            if nrec > 1073741824 {
                self.fail_str(STR_PTR("table overflow"), 14);
                return Vec::new();
            };
            if narr + nrec > 0 {
                self.mem_used = self.mem_used + (narr + nrec) * 24;
            };
            return bs_one(v_table(t));
        };
        if id == B_T_INSERT {
            if len(args) != 2 && len(args) != 3 {
                self.fail_str(STR_PTR("wrong number of arguments to 'insert'"), 37);
                return Vec::new();
            };
            let t = bs_arg(args, 0);
            let n = self.table_len(t.i);
            let pos = n + 1;
            let v = v_nil();
            if len(args) == 2 {
                v = args[1];
            } else {
                pos = self.bi_int(bs_arg(args, 1), n + 1);
                v = bs_arg(args, 2);
                if pos < 1 || pos > n + 1 {
                    self.fail_str(STR_PTR("position out of bounds"), 22);
                    return Vec::new();
                };
            };
            let i = n;
            while i >= pos {
                self.table_set(t.i, v_int(i + 1), self.table_get(t.i, v_int(i)));
                i = i - 1;
            }
            self.table_set(t.i, v_int(pos), v);
            return Vec::new();
        };
        if id == B_T_REMOVE {
            let t = bs_arg(args, 0);
            let n = self.table_len(t.i);
            let pos = n;
            if len(args) > 1 { pos = self.bi_int(bs_arg(args, 1), n); };
            if pos != n && (pos < 1 || pos > n + 1) {
                self.fail_str(STR_PTR("position out of bounds"), 22);
                return Vec::new();
            };
            let v = self.table_get(t.i, v_int(pos));
            let i = pos;
            while i < n {
                self.table_set(t.i, v_int(i), self.table_get(t.i, v_int(i + 1)));
                i = i + 1;
            }
            self.table_set(t.i, v_int(n), v_nil());
            return bs_one(v);
        };
        if id == B_T_SORT {
            let t = bs_arg(args, 0);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument #1 to 'sort' (table expected)"), 42);
                return Vec::new();
            };
            let cmp = v_nil();
            if len(args) > 1 {
                cmp = args[1];
            };
            let n = self.table_len(t.i);
            if n > 1 {
                self.sort_range(t.i, 1, n, cmp);
            };
            return Vec::new();
        };
        if id == B_T_CONCAT {
            let t = bs_arg(args, 0);
            let sep = bs_str(STR_PTR(""), 0);
            if len(args) > 1 { sep = v_to_string(args[1]); };
            let n = self.table_len(t.i);
            let i0 = 1;
            let i1 = n;
            if len(args) > 2 { i0 = self.bi_int(args[2], 1); };
            if len(args) > 3 { i1 = self.bi_int(args[3], n); };
            let parts = Vec::new();
            let i = i0;
            while i <= i1 {
                if i > i0 { parts.push(sep); };
                parts.push(v_to_string(self.table_get(t.i, v_int(i))));
                i = i + 1;
            }
            while len(parts) > 1 {
                let next = Vec::new();
                let j = 0;
                while j < (len(parts) as i64) {
                    if j + 1 < (len(parts) as i64) {
                        next.push(s_cat(parts[j], parts[j + 1]));
                    } else {
                        next.push(parts[j]);
                    };
                    j = j + 2;
                }
                parts = next;
            }
            if len(parts) == 0 {
                return bs_one(v_str(bs_str(STR_PTR(""), 0)));
            };
            return bs_one(v_str(parts[0]));
        };
        if id == B_T_PACK {
            let t = self.new_table();
            let i = 0;
            while i < (len(args) as i64) {
                self.table_set(t, v_int(i + 1), args[i]);
                i = i + 1;
            }
            self.table_set_str(t, bs_str(STR_PTR("n"), 1), v_int(len(args) as i64));
            return bs_one(v_table(t));
        };
        if id == B_T_UNPACK {
            let t = bs_arg(args, 0);
            let i0 = 1;
            let i1 = self.table_len(t.i);
            if len(args) > 1 { i0 = self.bi_int(args[1], 1); };
            if len(args) > 2 { i1 = self.bi_int(args[2], i1); };
            let r = Vec::new();
            let i = i0;
            while i <= i1 {
                r.push(self.table_get(t.i, v_int(i)));
                i = i + 1;
            }
            return r;
        };
        if id == B_M_FLOOR {
            return bs_one(v_int(sa_math_floor(self.math_num(args, 0)) as i64));
        };
        if id == B_M_CEIL {
            return bs_one(v_int(sa_math_ceil(self.math_num(args, 0)) as i64));
        };
        if id == B_M_ABS {
            let v = bs_arg(args, 0);
            if v.tag == VT_INT {
                if v.i < 0 {
                    return bs_one(v_int(0 - v.i));
                };
                return bs_one(v);
            };
            let f = self.math_num(args, 0);
            if f < 0.0 { return bs_one(v_num(0.0 - f)); };
            return bs_one(v_num(f));
        };
        if id == B_M_MAX {
            let best = bs_arg(args, 0);
            let i = 1;
            while i < (len(args) as i64) {
                let vn = self.math_num(args, i);
                if vn > v_as_num(best) {
                    best = args[i];
                };
                i = i + 1;
            }
            return bs_one(best);
        };
        if id == B_M_MIN {
            let best = bs_arg(args, 0);
            let i = 1;
            while i < (len(args) as i64) {
                let vn = self.math_num(args, i);
                if vn < v_as_num(best) {
                    best = args[i];
                };
                i = i + 1;
            }
            return bs_one(best);
        };
        if id == B_M_SQRT {
            return bs_one(v_num(sa_math_sqrt(self.math_num(args, 0))));
        };
        if id == B_M_TYPE {
            let v = bs_arg(args, 0);
            if v.tag == VT_INT { return bs_one(v_str(bs_str(STR_PTR("integer"), 7))); };
            if v.tag == VT_NUM { return bs_one(v_str(bs_str(STR_PTR("float"), 5))); };
            return bs_one(v_nil());
        };
        if id == B_M_TOINT {
            let v = bs_arg(args, 0);
            if v.tag == VT_INT { return bs_one(v); };
            if v.tag == VT_NUM && v_is_integral(v) {
                return bs_one(v_int(v.f as i64));
            };
            return bs_one(v_nil());
        };
        if id == B_M_RANDOM {
            let nargs = len(args) as i64;
            if nargs == 0 {
                let r = self.rng_next();
                let frac = (r >> 11) as f64 * (1.0 / 9007199254740992.0);
                return bs_one(v_num(frac));
            };
            if nargs == 1 {
                let hi = self.bi_int(args[0], 1);
                if hi < 1 {
                    self.fail_str(STR_PTR("bad argument to 'random'"), 24);
                    return Vec::new();
                };
                return bs_one(v_int(1 + self.rng_below(hi)));
            };
            let lo = self.bi_int(args[0], 1);
            let hi = self.bi_int(args[1], lo);
            if hi < lo {
                self.fail_str(STR_PTR("bad argument to 'random'"), 24);
                return Vec::new();
            };
            return bs_one(v_int(lo + self.rng_below(hi - lo + 1)));
        };
        if id == B_M_RANDOMSEED {
            let a = bs_arg(args, 0);
            let b = bs_arg(args, 1);
            if a.tag == VT_NIL {
                let s1 = (self.rng_next() >> 1) as i64;
                let s2 = (self.rng_next() >> 1) as i64;
                self.rng0 = s1 as u64;
                if self.rng0 == 0 { self.rng0 = 88172645463325252; };
                self.rng1 = s2 as u64;
                if self.rng1 == 0 { self.rng1 = 6364136223846793005; };
                return bs_two(v_int(s1), v_int(s2));
            };
            let s1 = self.bi_int(a, 1);
            let s2 = self.bi_int(b, s1);
            self.rng0 = s1 as u64;
            if self.rng0 == 0 { self.rng0 = 88172645463325252; };
            self.rng1 = s2 as u64;
            if self.rng1 == 0 { self.rng1 = 6364136223846793005; };
            return bs_two(v_int(s1), v_int(s2));
        };
        if id == B_M_LOG {
            let x = self.math_num(args, 0);
            if len(args) > 1 {
                let b = self.math_num(args, 1);
                return bs_one(v_num(log(x) / log(b)));
            };
            return bs_one(v_num(log(x)));
        };
        if id == B_M_EXP {
            return bs_one(v_num(exp(self.math_num(args, 0))));
        };
        if id == B_M_SIN {
            return bs_one(v_num(sa_math_sin(self.math_num(args, 0))));
        };
        if id == B_M_COS {
            return bs_one(v_num(sa_math_cos(self.math_num(args, 0))));
        };
        if id == B_M_TAN {
            return bs_one(v_num(tan(self.math_num(args, 0))));
        };
        if id == B_M_ASIN {
            return bs_one(v_num(asin(self.math_num(args, 0))));
        };
        if id == B_M_ACOS {
            return bs_one(v_num(acos(self.math_num(args, 0))));
        };
        if id == B_M_ATAN {
            let y = self.math_num(args, 0);
            if len(args) > 1 {
                return bs_one(v_num(atan2(y, self.math_num(args, 1))));
            };
            return bs_one(v_num(atan(y)));
        };
        if id == B_M_MODF {
            let x = bs_arg(args, 0);
            if x.tag == VT_INT {
                return bs_two(x, v_num(0.0));
            };
            let n = self.math_num(args, 0);
            let ip = 0.0;
            if n < 0.0 {
                ip = sa_math_ceil(n);
            } else {
                ip = sa_math_floor(n);
            };
            let frac = 0.0;
            if n != ip {
                frac = n - ip;
            };
            return bs_two(v_num(ip), v_num(frac));
        };
        if id == B_M_DEG {
            return bs_one(v_num(self.math_num(args, 0) * 57.29577951308232));
        };
        if id == B_M_RAD {
            return bs_one(v_num(self.math_num(args, 0) * 0.017453292519943295));
        };
        if id == B_OS_CLOCK {
            return bs_one(v_num(0.0));
        };
        if id == B_OS_TIME {
            return bs_one(v_int(0));
        };
        return Vec::new();
    };
    fn bi_dbg_info(&self, args: &Vec<Value>) -> Vec<Value> {
        let t = self.new_table();
        self.table_set_str(t, istr(STR_PTR("currentline"), 11), v_int(self.curline));
        self.table_set_str(t, istr(STR_PTR("source"), 6), v_str(istr(STR_PTR("=?"), 2)));
        self.table_set_str(t, istr(STR_PTR("short_src"), 9), v_str(istr(STR_PTR("=?"), 2)));
        self.table_set_str(t, istr(STR_PTR("what"), 4), v_str(istr(STR_PTR("Lua"), 3)));
        self.table_set_str(t, istr(STR_PTR("linedefined"), 11), v_int(0));
        self.table_set_str(t, istr(STR_PTR("lastlinedefined"), 15), v_int(0));
        self.table_set_str(t, istr(STR_PTR("nups"), 4), v_int(0));
        self.table_set_str(t, istr(STR_PTR("nparams"), 7), v_int(0));
        self.table_set_str(t, istr(STR_PTR("isvararg"), 8), v_bool(true));
        let r = Vec::new();
        r.push(v_table(t));
        return r;
    }

    fn sort_lt(&self, a: Value, b: Value, cmp: Value) -> bool {
        if cmp.tag == VT_FUNC || cmp.tag == VT_BUILTIN {
            let cargs = Vec::new();
            cargs.push(a);
            cargs.push(b);
            let out = self.call_value(cmp, cargs);
            if len(out) > 0 {
                return v_truthy(out[0]);
            };
            return false;
        };
        return v_lt(&a, &b);
    }

    fn sort_swap(&self, tid: i64, i: i64, j: i64) -> void {
        let vi = self.table_get(tid, v_int(i));
        let vj = self.table_get(tid, v_int(j));
        self.table_set(tid, v_int(i), vj);
        self.table_set(tid, v_int(j), vi);
    }

    fn sort_range(&self, tid: i64, lo: i64, hi: i64, cmp: Value) -> void {
        if lo >= hi {
            return;
        };
        if hi - lo < 12 {
            let i = lo + 1;
            while i <= hi {
                let key = self.table_get(tid, v_int(i));
                let j = i - 1;
                while j >= lo {
                    let cur = self.table_get(tid, v_int(j));
                    if self.sort_lt(key, cur, cmp) == false {
                        break;
                    };
                    self.sort_swap(tid, j + 1, j);
                    j = j - 1;
                }
                self.table_set(tid, v_int(j + 1), key);
                i = i + 1;
            }
            return;
        };
        let mid = (lo + hi) / 2;
        let vmid = self.table_get(tid, v_int(mid));
        let vlo = self.table_get(tid, v_int(lo));
        if self.sort_lt(vmid, vlo, cmp) {
            self.sort_swap(tid, mid, lo);
        };
        let vhi = self.table_get(tid, v_int(hi));
        let vmid2 = self.table_get(tid, v_int(mid));
        if self.sort_lt(vhi, vmid2, cmp) {
            self.sort_swap(tid, hi, mid);
        };
        let vmid3 = self.table_get(tid, v_int(mid));
        let vlo2 = self.table_get(tid, v_int(lo));
        if self.sort_lt(vmid3, vlo2, cmp) {
            self.sort_swap(tid, mid, lo);
        };
        let pivot = self.table_get(tid, v_int(lo));
        let i = lo;
        let j = hi;
        while i <= j {
            let vi = self.table_get(tid, v_int(i));
            while self.sort_lt(vi, pivot, cmp) {
                i = i + 1;
                vi = self.table_get(tid, v_int(i));
            }
            let vj = self.table_get(tid, v_int(j));
            while self.sort_lt(pivot, vj, cmp) {
                j = j - 1;
                vj = self.table_get(tid, v_int(j));
            }
            if i <= j {
                self.sort_swap(tid, i, j);
                i = i + 1;
                j = j - 1;
            }
        }
        self.sort_range(tid, lo, j, cmp);
        self.sort_range(tid, i, hi, cmp);
    }

    fn bi_searchpath(&self, args: &Vec<Value>) -> Vec<Value> {
        let name = v_to_string(bs_arg(args, 0));
        let path = v_to_string(bs_arg(args, 1));
        let sep = s_from(STR_PTR("."), 1);
        if len(args) > 2 {
            sep = v_to_string(args[2]);
        };
        let dirsep = s_from(STR_PTR("/"), 1);
        if len(args) > 3 {
            dirsep = v_to_string(args[3]);
        };
        let nm = name;
        if s_len(sep) > 0 {
            if self.s_index_of(nm, sep) >= 0 {
                nm = self.s_replace_all(nm, sep, dirsep);
            };
        };
        let expanded = self.s_replace_all(path, s_from(STR_PTR("?"), 1), nm);
        let parts = self.s_split(expanded, s_from(STR_PTR(";"), 1));
        let i = 0;
        while i < (len(parts) as i64) {
            let f = parts[i].s;
            let fp = sa_fmt_buffer_data(f);
            let fl = s_len(f);
            if sa_std_fs_exists(fp, fl) == 0 {
                let r = Vec::new();
                r.push(v_str(f));
                return r;
            };
            i = i + 1;
        }
        let msg = bs_str(STR_PTR("no file '"), 9);
        let j = 0;
        while j < (len(parts) as i64) {
            if j > 0 {
                msg = s_cat(msg, s_from(STR_PTR("'\n\tno file '"), 12));
            };
            msg = s_cat(msg, parts[j].s);
            j = j + 1;
        }
        msg = s_cat(msg, s_from(STR_PTR("'"), 1));
        let r = Vec::new();
        r.push(v_nil());
        r.push(v_str(msg));
        return r;
    }

    fn require_paths(&self, pkgid: i64, name: u64, which: u64) -> Vec<Value> {
        let path = self.table_get_str(pkgid, which);
        if path.tag != VT_STR {
            let m1 = s_from(STR_PTR("'package."), 9);
            let m2 = s_cat(m1, which);
            let m3 = s_cat(m2, s_from(STR_PTR("' must be a string"), 18));
            self.fail_text(m3);
            return Vec::new();
        };
        let nm = self.s_replace_all(name, s_from(STR_PTR("."), 1), s_from(STR_PTR("/"), 1));
        let expanded = self.s_replace_all(path.s, s_from(STR_PTR("?"), 1), nm);
        return self.s_split(expanded, s_from(STR_PTR(";"), 1));
    }

    fn load_module(&self, file: u64, name: u64) -> Value {
        let p: ptr = sa_fmt_buffer_data(file);
        let pl = s_len(file);
        let buf = sa_fs_read_file(p, pl, 8388608);
        if buf == 0 {
            self.fail_text(s_from(STR_PTR("module not found"), 16));
            return v_nil();
        };
        let dp: ptr = sa_fs_read_buffer_data(buf);
        let dl = sa_fs_read_buffer_len(buf);
        let text = s_from(dp, dl);
        let st = sa_fs_read_buffer_free(buf);
        let lx = lex_source(text);
        let pr = parse_tokens_base(lx, len(self.nodes) as i64, len(self.lists) as i64);
        if pr.err != 0 {
            self.fail_text(s_from(STR_PTR("syntax error in module"), 22));
            return v_nil();
        };
        let i = 0;
        while i < (len(pr.nodes) as i64) {
            let nd = pr.nodes[i];
            self.nodes.push(nd);
            i = i + 1;
        }
        let j = 0;
        while j < (len(pr.lists) as i64) {
            let ls = pr.lists[j];
            self.lists.push(ls);
            j = j + 1;
        }
        let fid = self.new_func(Vec::new(), pr.root, 1, 0, -1);
        let cargs = Vec::new();
        cargs.push(v_str(name));
        let out = self.call_value(v_func(fid), cargs);
        let res = v_bool(true);
        if len(out) > 0 {
            if out[0].tag != VT_NIL {
                res = out[0];
            };
        };
        return res;
    }

    fn bi_require(&self, args: &Vec<Value>) -> Vec<Value> {
        let name = bs_arg(args, 0);
        if name.tag != VT_STR {
            self.fail_str(STR_PTR("bad argument to 'require'"), 25);
            return Vec::new();
        };
        let pkg = self.table_get_str(self.globals, istr(STR_PTR("package"), 7));
        let loaded = self.table_get_str(pkg.i, istr(STR_PTR("loaded"), 6));
        let cached = self.table_get(loaded.i, v_str(name.s));
        if cached.tag != VT_NIL {
            let r = Vec::new();
            r.push(cached);
            return r;
        };
        let pre = self.table_get_str(pkg.i, istr(STR_PTR("preload"), 7));
        if pre.tag == VT_TABLE {
            let pf = self.table_get(pre.i, v_str(name.s));
            if pf.tag != VT_NIL {
                let cargs = Vec::new();
                cargs.push(v_str(name.s));
                let pout = self.call_value(pf, cargs);
                let pres = v_bool(true);
                if len(pout) > 0 {
                    if pout[0].tag != VT_NIL {
                        pres = pout[0];
                    };
                };
                self.table_set(loaded.i, v_str(name.s), pres);
                let pr = Vec::new();
                pr.push(pres);
                return pr;
            };
        };
        let m1 = s_cat(s_from(STR_PTR("module '"), 8), name.s);
        let m2 = s_cat(m1, s_from(STR_PTR("' not found:"), 12));
        let m3 = s_cat(m2, s_from(STR_PTR("\n\tno field package.preload['"), 28));
        let m4 = s_cat(m3, name.s);
        let msg = s_cat(m4, s_from(STR_PTR("']"), 2));
        let pfiles = self.require_paths(pkg.i, name.s, istr(STR_PTR("path"), 4));
        if self.err != 0 {
            return Vec::new();
        };
        let i = 0;
        while i < (len(pfiles) as i64) {
            let f = pfiles[i].s;
            let fp = sa_fmt_buffer_data(f);
            let fl = s_len(f);
            if sa_std_fs_exists(fp, fl) == 0 {
                let r = self.load_module(f, name.s);
                if r.tag == VT_NIL {
                    return Vec::new();
                };
                self.table_set(loaded.i, v_str(name.s), r);
                let rr = Vec::new();
                rr.push(r);
                return rr;
            };
            let n1 = s_cat(msg, s_from(STR_PTR("\n\tno file '"), 11));
            let n2 = s_cat(n1, f);
            msg = s_cat(n2, s_from(STR_PTR("'"), 1));
            i = i + 1;
        }
        let cfiles = self.require_paths(pkg.i, name.s, istr(STR_PTR("cpath"), 5));
        if self.err != 0 {
            return Vec::new();
        };
        let j = 0;
        while j < (len(cfiles) as i64) {
            let f = cfiles[j].s;
            let n3 = s_cat(msg, s_from(STR_PTR("\n\tno file '"), 11));
            let n4 = s_cat(n3, f);
            msg = s_cat(n4, s_from(STR_PTR("'"), 1));
            j = j + 1;
        }
        self.fail_text(msg);
        return Vec::new();
    }

    fn one_str(&self, msg: ptr, n: u64) -> Vec<Value> {
        let r = Vec::new();
        r.push(v_nil());
        r.push(v_str(istr(msg, n)));
        return r;
    }

};
