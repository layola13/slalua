@import "sa_std/vec.sa"
@import "sa_std/string.sa"
@import "src/value.sla"
@import "src/strutil.sla"
@import "src/interp_core.sla"
@import "src/interp_expr.sla"
@import "src/opcodes.sla"
@import "src/libutil.sla"
@import "src/patstr.sla"
@import "src/libpack.sla"

const MAXSSIZE: i64 = 9223372036854775807;

impl Interp {
    fn builtin_string(&self, id: i64, args: &Vec<Value>) -> Vec<Value> {
        if id == B_S_LEN {
            return bs_one(v_int(s_len(v_to_string(bs_arg(args, 0))) as i64));
        };
        if id == B_S_SUB {
            let s = v_to_string(bs_arg(args, 0));
            let n = s_len(s) as i64;
            let i0 = bs_pos(self.bi_int(bs_arg(args, 1), 1), n);
            let i1 = n;
            if len(args) > 2 {
                i1 = bs_pos(self.bi_int(bs_arg(args, 2), n), n);
            };
            if i0 < 1 { i0 = 1; };
            if i1 > n { i1 = n; };
            if i0 > i1 { return bs_one(v_str(bs_str(STR_PTR(""), 0))); };
            return bs_one(v_str(s_slice(s, (i0 - 1) as u64, (i1 - i0 + 1) as u64)));
        };
        if id == B_S_UPPER {
            return bs_one(v_str(self.bi_case(v_to_string(bs_arg(args, 0)), 0)));
        };
        if id == B_S_LOWER {
            return bs_one(v_str(self.bi_case(v_to_string(bs_arg(args, 0)), 1)));
        };
        if id == B_S_BYTE {
            let s = v_to_string(bs_arg(args, 0));
            let n = s_len(s) as i64;
            let i0 = 1;
            if len(args) > 1 { i0 = bs_pos(self.bi_int(bs_arg(args, 1), 1), n); };
            let i1 = i0;
            if len(args) > 2 { i1 = bs_pos(self.bi_int(bs_arg(args, 2), i0), n); };
            let r = Vec::new();
            let i = i0;
            while i <= i1 && i <= n {
                if i >= 1 {
                    r.push(v_int(s_byte(s, (i - 1) as u64) as i64));
                };
                i = i + 1;
            }
            return r;
        };
        if id == B_S_CHAR {
            let out = bs_str(STR_PTR(""), 0);
            let i = 0;
            while i < (len(args) as i64) {
                let c = self.bi_int(args[i], 0);
                if c < 0 || c > 255 {
                    self.fail_str(STR_PTR("value out of range"), 18);
                    return Vec::new();
                };
                out = s_cat(out, s_char(c as u8));
                i = i + 1;
            }
            return bs_one(v_str(out));
        };
        if id == B_S_REP {
            let s = v_to_string(bs_arg(args, 0));
            let n = self.bi_int(bs_arg(args, 1), 0);
            let sep = bs_str(STR_PTR(""), 0);
            if len(args) > 2 { sep = v_to_string(bs_arg(args, 2)); };
            let l = s_len(s) as i64;
            let lsep = s_len(sep) as i64;
            if n > 0 {
                if l + lsep > MAXSSIZE / n {
                    self.fail_str(STR_PTR("resulting string too large"), 26);
                    return Vec::new();
                };
            };
            let out = bs_str(STR_PTR(""), 0);
            if n > 0 {
                if l == 0 {
                    let i: i64 = 0;
                    while i < n {
                        if i > 0 { out = s_cat(out, sep); };
                        i = i + 1;
                    }
                    return bs_one(v_str(out));
                };
                if lsep == 0 {
                    // build by doubling: O(n log n) instead of O(n^2)
                    let unit = s;
                    let count: i64 = 1;
                    let total: i64 = l;
                    while total < n * l {
                        unit = s_cat(unit, unit);
                        count = count * 2;
                        total = total * 2;
                    }
                    let need = n * l;
                    let chunk = s_slice(unit, 0, need);
                    out = s_cat(out, chunk);
                    return bs_one(v_str(out));
                };
            };
            let i: i64 = 0;
            while i < n {
                if i > 0 { out = s_cat(out, sep); };
                out = s_cat(out, s);
                i = i + 1;
            }
            return bs_one(v_str(out));
        };
        if id == B_S_REVERSE {
            let s = v_to_string(bs_arg(args, 0));
            let n = s_len(s);
            let out = bs_str(STR_PTR(""), 0);
            let i = n;
            while i > 0 {
                out = s_cat(out, s_char(s_byte(s, i - 1)));
                i = i - 1;
            }
            return bs_one(v_str(out));
        };
        if id == B_S_PACKSIZE {
            let f = v_to_string(bs_arg(args, 0));
            return bs_one(v_int(self.packsize(f)));
        };
        if id == B_S_FIND {
            return self.pat_find_aux(true, args);
        };
        if id == B_S_MATCH {
            return self.pat_find_aux(false, args);
        };
        if id == B_S_GSUB {
            return self.pat_gsub(args);
        };
        if id == B_S_GMATCH {
            return self.pat_gmatch(args);
        };
        if id == B_S_GMATCH_NEXT {
            return self.pat_gmatch_next(args);
        };
        if id == B_S_FORMAT {
            return bs_one(v_str(self.bi_format(args)));
        };
        return Vec::new();
    }

    fn bi_case(&self, s: u64, lower: i64) -> u64 {
        let n = s_len(s);
        let out = bs_str(STR_PTR(""), 0);
        let i: u64 = 0;
        while i < n {
            let c = s_byte(s, i);
            let d = c;
            if lower == 1 {
                if c >= 65 && c <= 90 { d = c + 32; };
            } else {
                if c >= 97 && c <= 122 { d = c - 32; };
            };
            out = s_cat(out, s_char(d));
            i = i + 1;
        }
        return out;
    };

    fn bi_format(&self, args: &Vec<Value>) -> u64 {
        let f = v_to_string(bs_arg(args, 0));
        let n = s_len(f);
        let out = bs_str(STR_PTR(""), 0);
        let ai = 1;
        let i: u64 = 0;
        while i < n {
            let c = s_byte(f, i);
            if c != 37 {
                out = s_cat(out, s_char(c));
                i = i + 1;
                continue;
            };
            i = i + 1;
            if i >= n {
                out = s_cat(out, s_char(37));
                continue;
            };
            let k = s_byte(f, i);
            i = i + 1;
            if k == 37 {
                out = s_cat(out, s_char(37));
                continue;
            };
            let v = bs_arg(args, ai);
            ai = ai + 1;
            if k == 115 {
                out = s_cat(out, v_to_string(v));
            } else {
                if k == 100 || k == 105 {
                    out = s_cat(out, s_i64(self.bi_int(v, 0)));
                } else {
                    if k == 102 || k == 103 {
                        out = s_cat(out, s_f64(v_as_num(v)));
                    } else {
                        if k == 99 {
                            out = s_cat(out, s_char(self.bi_int(v, 0) as u8));
                        } else {
                            if k == 120 {
                                out = s_cat(out, s_hex(self.bi_int(v, 0) as u64));
                            } else {
                                out = s_cat(out, v_to_string(v));
                            }
                        }
                    }
                }
            }
        }
        return out;
    }

    fn pat_posrelat(&self, pos: i64, len: i64) -> i64 {
        if pos >= 0 {
            return pos;
        };
        if 0 - pos > len {
            return 0;
        };
        return len + pos + 1;
    }

    fn pat_find_aux(&self, find: bool, args: &Vec<Value>) -> Vec<Value> {
        let s = v_to_string(bs_arg(args, 0));
        let p = v_to_string(bs_arg(args, 1));
        let ls = s_len(s) as i64;
        let lp = s_len(p) as i64;
        let init = 1;
        if len(args) > 2 {
            init = self.bi_int(bs_arg(args, 2), 1);
        };
        let pos = self.pat_posrelat(init, ls);
        if pos < 1 {
            return bs_one(v_nil());
        };
        let init0 = pos - 1;
        if init0 > ls {
            return bs_one(v_nil());
        };
        let plain = false;
        if len(args) > 3 {
            plain = v_truthy(bs_arg(args, 3));
        };
        let st = pat_state_new(s, p);
        if find && (plain || pat_nospecials(&st)) {
            let idx = pat_plain_find(&st, init0);
            if idx >= 0 {
                let r = Vec::new();
                r.push(v_int(idx + 1));
                r.push(v_int(idx + lp));
                return r;
            };
            return bs_one(v_nil());
        };
        if pat_search(&st, init0) == 0 {
            return bs_one(v_nil());
        };
        if st.err != 0 {
            self.fail_text(pat_err_msg(&st));
            return Vec::new();
        };
        if find {
            let r = Vec::new();
            r.push(v_int(st.mstart + 1));
            r.push(v_int(st.mend));
            let caps = pat_push_captures(&st, st.mstart, st.mend, false);
            let i = 0;
            while i < (len(caps) as i64) {
                r.push(caps[i]);
                i = i + 1;
            }
            return r;
        };
        return pat_push_captures(&st, st.mstart, st.mend, true);
    }

    fn pat_add_s(&self, st: &PatState, repl: u64, s: i64, e: i64) -> Vec<Value> {
        let buf = Vec::new();
        let rl = s_len(repl);
        let i = 0;
        while i < rl {
            let c = s_byte(repl, i as u64);
            if c != 37 {
                let start = i;
                let j = i;
                while j < rl {
                    if s_byte(repl, j as u64) == 37 {
                        break;
                    };
                    j = j + 1;
                }
                buf.push(v_str(s_slice(repl, start as u64, (j - start) as u64)));
                i = pat_assign(i, j);
                continue;
            };
            let k = i + 1;
            if k >= rl {
                self.fail_str(STR_PTR("invalid use of '%' in replacement string"), 40);
                return buf;
            };
            let d = s_byte(repl, k as u64);
            if d == 37 {
                buf.push(v_str(bs_str(STR_PTR("%"), 1)));
            } else {
                if d == 48 {
                    buf.push(v_str(s_slice(st.src, s as u64, (e - s) as u64)));
                } else {
                    if d >= 49 && d <= 57 {
                        let idx = (d as i64) - 49;
                        if idx >= st.level && idx != 0 {
                            let e1 = s_from(STR_PTR("invalid capture index %"), 23);
                            let e2 = s_cat(e1, s_char(d));
                            self.fail_text(e2);
                            return buf;
                        };
                        if idx < (len(st.cap_len) as i64) {
                            if st.cap_len[idx] == -1 {
                                st.err = 1;
                                st.errnum = idx + 1;
                            };
                        };
                        if st.err != 0 {
                            self.fail_text(pat_err_msg(st));
                            return buf;
                        };
                        let cap = pat_one_capture(st, idx, s, e);
                        if cap.tag == VT_INT {
                            buf.push(v_str(s_i64(cap.i)));
                        } else {
                            buf.push(v_str(cap.s));
                        };
                    } else {
                        self.fail_str(STR_PTR("invalid use of '%' in replacement string"), 40);
                        return buf;
                    };
                };
            };
            i = pat_assign(i, k + 1);
        }
        return buf;
    };

    fn pat_push_value(&self, v: Value) -> Vec<Value> {
        let buf = Vec::new();
        if v.tag == VT_STR {
            buf.push(v_str(v.s));
            return buf;
        };
        if v.tag == VT_INT {
            buf.push(v_str(s_i64(v.i)));
            return buf;
        };
        if v.tag == VT_NUM {
            buf.push(v_str(s_f64(v.f)));
            return buf;
        };
        let e1 = s_from(STR_PTR("invalid replacement value (a "), 29);
        let e2 = s_cat(e1, v_type_name(v));
        let e3 = s_cat(e2, s_from(STR_PTR(")"), 1));
        self.fail_text(e3);
        return buf;
    }

    fn pat_add_value(&self, st: &PatState, repl: Value, s: i64, e: i64) -> (Vec<Value>, bool) {
        if repl.tag == VT_FUNC || repl.tag == VT_BUILTIN {
            let caps = pat_push_captures(st, s, e, true);
            let out = self.call_value(repl, caps);
            let v = v_nil();
            if len(out) > 0 {
                v = out[0];
            };
            if v_truthy(v) == false {
                let keep = Vec::new();
                keep.push(v_str(s_slice(st.src, s as u64, (e - s) as u64)));
                return (keep, false);
            };
            return (self.pat_push_value(v), true);
        };
        if repl.tag == VT_TABLE {
            let cap0 = pat_one_capture(st, 0, s, e);
            let v = self.get_index(repl, cap0);
            if v_truthy(v) == false {
                let keep = Vec::new();
                keep.push(v_str(s_slice(st.src, s as u64, (e - s) as u64)));
                return (keep, false);
            };
            return (self.pat_push_value(v), true);
        };
        let rs = v_to_string(repl);
        return (self.pat_add_s(st, rs, s, e), true);
    }

    fn pat_gmatch(&self, args: &Vec<Value>) -> Vec<Value> {
        let s = v_to_string(bs_arg(args, 0));
        let p = v_to_string(bs_arg(args, 1));
        let ls = s_len(s) as i64;
        let init = 1;
        if len(args) > 2 {
            init = self.bi_int(bs_arg(args, 2), 1);
        };
        let pos = self.pat_posrelat(init, ls);
        let init0 = 0;
        if pos >= 1 {
            init0 = pos - 1;
        };
        if init0 > ls {
            init0 = ls;
        };
        let st = self.new_table();
        self.table_set_str(st, istr(STR_PTR("s"), 1), v_str(s));
        self.table_set_str(st, istr(STR_PTR("p"), 1), v_str(p));
        self.table_set_str(st, istr(STR_PTR("pos"), 3), v_int(init0));
        self.table_set_str(st, istr(STR_PTR("last"), 4), v_int(0 - 1));
        let r = Vec::new();
        r.push(v_builtin(B_S_GMATCH_NEXT));
        r.push(v_table(st));
        r.push(v_int(0));
        return r;
    }

    fn pat_gmatch_next(&self, args: &Vec<Value>) -> Vec<Value> {
        let stv = bs_arg(args, 0);
        if stv.tag != VT_TABLE {
            return Vec::new();
        };
        let sv = self.table_get_str(stv.i, istr(STR_PTR("s"), 1));
        let pv = self.table_get_str(stv.i, istr(STR_PTR("p"), 1));
        let posv = self.table_get_str(stv.i, istr(STR_PTR("pos"), 3));
        let lastv = self.table_get_str(stv.i, istr(STR_PTR("last"), 4));
        let ls = s_len(sv.s) as i64;
        let st = pat_state_new(sv.s, pv.s);
        let src = posv.i;
        let last = lastv.i;
        let going = true;
        let found = 0;
        while going {
            st.level = 0;
            st.depth = PAT_MAXCCALLS;
            let e = pat_match(&st, src, 0);
            if e >= 0 && e != last {
                self.table_set_str(stv.i, istr(STR_PTR("pos"), 3), v_int(e));
                self.table_set_str(stv.i, istr(STR_PTR("last"), 4), v_int(e));
                st.mstart = src;
                st.mend = e;
                found = 1;
                going = false;
                continue;
            };
            src = src + 1;
            if src > ls {
                going = false;
                continue;
            };
        }
        if found == 0 {
            return Vec::new();
        };
        return pat_push_captures(&st, st.mstart, st.mend, true);
    }

    fn pat_gsub(&self, args: &Vec<Value>) -> Vec<Value> {
        let s = v_to_string(bs_arg(args, 0));
        let p = v_to_string(bs_arg(args, 1));
        let repl = bs_arg(args, 2);
        let ls = s_len(s) as i64;
        let lp = s_len(p) as i64;
        let max_s = ls + 1;
        if len(args) > 3 {
            max_s = self.bi_int(bs_arg(args, 3), ls + 1);
        };
        let anchor = false;
        let pat_start = 0;
        if lp > 0 {
            if s_byte(p, 0) == 94 {
                anchor = true;
                pat_start = 1;
            };
        };
        let st = pat_state_new(s, p);
        let pieces = Vec::new();
        let src = 0;
        let copied = 0;
        let lastmatch = -1;
        let n = 0;
        let changed = false;
        let going = true;
        while going && n < max_s {
            st.level = 0;
            st.depth = PAT_MAXCCALLS;
            let e = pat_match(&st, src, pat_start);
            if st.err != 0 {
                self.fail_text(pat_err_msg(&st));
                return Vec::new();
            };
            if e >= 0 && e != lastmatch {
                n = n + 1;
                if src > copied {
                    pieces.push(v_str(s_slice(s, copied as u64, (src - copied) as u64)));
                };
                let (adds, c) = self.pat_add_value(&st, repl, src, e);
                let ai = 0;
                while ai < (len(adds) as i64) {
                    pieces.push(adds[ai]);
                    ai = ai + 1;
                }
                if c {
                    changed = true;
                };
                src = e;
                copied = e;
                lastmatch = e;
            } else {
                if src < ls {
                    pieces.push(v_str(s_slice(s, src as u64, 1)));
                    src = src + 1;
                    copied = src;
                } else {
                    going = false;
                    continue;
                };
            };
            if anchor {
                going = false;
            };
        }
        if ls > copied {
            pieces.push(v_str(s_slice(s, copied as u64, (ls - copied) as u64)));
        };
        let r = Vec::new();
        if changed == false {
            r.push(v_str(s));
        } else {
            let out = bs_str(STR_PTR(""), 0);
            let i = 0;
            while i < (len(pieces) as i64) {
                out = s_cat(out, pieces[i].s);
                i = i + 1;
            }
            r.push(v_str(out));
        };
        r.push(v_int(n));
        return r;
    }
};
