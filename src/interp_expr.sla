@import "sa_std/vec.sa"
@import "sa_std/string.sa"
@import "sa_std/math.sai"
@import "src/tok.sla"
@import "src/ast.sla"
@import "src/value.sla"
@import "src/strutil.sla"
@import "src/interp_core.sla"
@import "src/interp_stmt.sla"
@import "src/builtins.sla"

fn v_is_integral(v: Value) -> bool {
    if v.tag == VT_INT {
        return true;
    };
    if v.tag == VT_NUM {
        return v.f == ((v.f as i64) as f64);
    };
    return false;
}

fn v_to_i64(v: Value) -> i64 {
    if v.tag == VT_INT {
        return v.i;
    };
    return v.f as i64;
}

impl Interp {
    fn eval(&self, env: i64, id: i64) -> Value {
        let nd = self.nd(id);
        if nd.kind == NK_NIL {
            return v_nil();
        };
        if nd.kind == NK_TRUE {
            return v_bool(true);
        };
        if nd.kind == NK_FALSE {
            return v_bool(false);
        };
        if nd.kind == NK_INT {
            return v_int(nd.n);
        };
        if nd.kind == NK_NUM {
            return v_num(nd.f);
        };
        if nd.kind == NK_STR {
            return v_str(nd.s);
        };
        if nd.kind == NK_NAME {
            return self.env_get(env, nd.s);
        };
        if nd.kind == NK_VARARG {
            let vn = self.env_vargname(env);
            if vn != 0 {
                let t = self.env_get(env, vn);
                if t.tag == VT_TABLE {
                    let nv = self.vararg_n(t.i);
                    if nv < 1 {
                        return v_nil();
                    };
                    return self.table_get(t.i, v_int(1));
                };
                return v_nil();
            };
            if len(self.envs[env].varargs) > 0 {
                return self.envs[env].varargs[0];
            };
            return v_nil();
        };
        if nd.kind == NK_PAREN {
            return self.eval(env, nd.a);
        };
        if nd.kind == NK_INDEX {
            let obj = self.eval(env, nd.a);
            let key = v_str(nd.s);
            if nd.b != 0 {
                key = self.eval(env, nd.b);
            };
            return self.get_index(obj, key);
        };
        if nd.kind == NK_CALL || nd.kind == NK_METHOD {
            let out = self.eval_call(env, id);
            if len(out) > 0 {
                return out[0];
            };
            return v_nil();
        };
        if nd.kind == NK_FUNC {
            return v_func(self.make_func(env, id));
        };
        if nd.kind == NK_TABLE {
            return self.make_table(env, id);
        };
        if nd.kind == NK_BIN {
            return self.eval_bin(env, nd);
        };
        if nd.kind == NK_UN {
            return self.eval_un(env, nd);
        };
        return v_nil();
    }

    fn eval_call(&self, env: i64, id: i64) -> Vec<Value> {
        let nd = self.nd(id);
        if nd.kind == NK_CALL {
            let f = self.eval(env, nd.a);
            let args = self.eval_list(env, nd.b);
            return self.call_value(f, args);
        };
        let obj = self.eval(env, nd.a);
        let f = self.get_index(obj, v_str(nd.s));
        let args = self.eval_list(env, nd.b);
        let all = Vec::new();
        all.push(obj);
        let i = 0;
        while i < (len(args) as i64) {
            all.push(args[i]);
            i = i + 1;
        }
        return self.call_value(f, all);
    }

    fn vararg_n(&self, t: i64) -> i64 {
        let cnt = self.table_get_str(t, s_from(STR_PTR("n"), 1));
        if cnt.tag != VT_INT {
            self.fail_str(STR_PTR("no proper 'n'"), 13);
            return 0;
        };
        if cnt.i < 0 || cnt.i > 1048576 {
            self.fail_str(STR_PTR("no proper 'n'"), 13);
            return 0;
        };
        return cnt.i;
    }

    fn eval_multi(&self, env: i64, id: i64) -> Vec<Value> {
        let out = Vec::new();
        let nd = self.nd(id);
        if nd.kind == NK_CALL || nd.kind == NK_METHOD {
            return self.eval_call(env, id);
        };
        if nd.kind == NK_VARARG {
            let vn = self.env_vargname(env);
            if vn != 0 {
                let t = self.env_get(env, vn);
                if t.tag != VT_TABLE {
                    return out;
                };
                let nv = self.vararg_n(t.i);
                let i = 1;
                while i <= nv {
                    out.push(self.table_get(t.i, v_int(i)));
                    i = i + 1;
                }
                return out;
            };
            let i = 0;
            while i < (len(self.envs[env].varargs) as i64) {
                out.push(self.envs[env].varargs[i]);
                i = i + 1;
            }
            return out;
        };
        out.push(self.eval(env, id));
        return out;
    }

    fn eval_list(&self, env: i64, lid: i64) -> Vec<Value> {
        let out = Vec::new();
        let n = self.list_len(lid);
        let i = 0;
        while i < n {
            let vals = self.eval_multi(env, self.list_get(lid, i));
            if i == n - 1 {
                let j = 0;
                while j < (len(vals) as i64) {
                    out.push(vals[j]);
                    j = j + 1;
                }
            } else {
                if len(vals) > 0 {
                    out.push(vals[0]);
                } else {
                    out.push(v_nil());
                }
            };
            i = i + 1;
        }
        return out;
    }

    fn make_func(&self, env: i64, id: i64) -> i64 {
        let nd = self.nd(id);
        let ps = Vec::new();
        let n = self.list_len(nd.a);
        let i = 0;
        while i < n {
            ps.push(self.list_get(nd.a, i));
            i = i + 1;
        }
        return self.new_func(ps, nd.b, nd.n, nd.d, env);
    }

    fn make_table(&self, env: i64, id: i64) -> Value {
        let nd = self.nd(id);
        let tid = self.new_table();
        let n = self.list_len(nd.a);
        let i = 0;
        let seq = 1;
        while i < n {
            let fid = self.list_get(nd.a, i);
            let f = self.nd(fid);
            let key = v_nil();
            let val = v_nil();
            if f.n == 1 {
                key = self.eval(env, f.a);
                val = self.eval(env, f.b);
            };
            if f.n == 2 {
                key = v_str(f.s);
                val = self.eval(env, f.b);
            };
            if f.n == 0 {
                let expand = false;
                if i == n - 1 {
                    let ex = self.nd(f.b);
                    if ex.kind == NK_VARARG || ex.kind == NK_CALL || ex.kind == NK_METHOD {
                        expand = true;
                    };
                };
                if expand {
                    let vals = self.eval_multi(env, f.b);
                    let j = 0;
                    while j < (len(vals) as i64) {
                        self.table_set(tid, v_int(seq), vals[j]);
                        seq = seq + 1;
                        j = j + 1;
                    }
                    i = i + 1;
                    continue;
                };
                val = self.eval(env, f.b);
                key = v_int(seq);
                seq = seq + 1;
            };
            self.table_set(tid, key, val);
            i = i + 1;
        }
        return v_table(tid);
    }

    fn get_index(&self, obj: Value, key: Value) -> Value {
        if obj.tag == VT_TABLE {
            let v = self.table_get(obj.i, key);
            if v.tag != VT_NIL {
                return v;
            };
            let meta = self.tables[obj.i].meta;
            if meta >= 0 {
                let idx = self.table_get_str(meta, s_from(STR_PTR("__index"), 7));
                if idx.tag == VT_TABLE {
                    return self.get_index(idx, key);
                };
                if idx.tag == VT_FUNC || idx.tag == VT_BUILTIN {
                    let cargs = Vec::new();
                    cargs.push(obj);
                    cargs.push(key);
                    let out = self.call_value(idx, cargs);
                    if len(out) > 0 {
                        return out[0];
                    };
                };
            };
            return v_nil();
        };
        if obj.tag == VT_STR {
            let st = self.table_get_str(self.globals, s_from(STR_PTR("string"), 6));
            if st.tag == VT_TABLE {
                let sv = self.table_get(st.i, key);
                if sv.tag != VT_NIL {
                    return sv;
                };
            };
            let sm = self.table_get_str(self.globals, s_from(STR_PTR("__strmeta"), 9));
            if sm.tag == VT_TABLE {
                return self.table_get(sm.i, key);
            };
        };
        self.fail_str(STR_PTR("attempt to index a non-table value"), 34);
        return v_nil();
    }

    fn one_arg(&self, a: Value, b: Value) -> Vec<Value> {
        let out = Vec::new();
        out.push(a);
        return out;
    }

    fn set_index(&self, obj: Value, key: Value, val: Value) -> void {
        if obj.tag == VT_TABLE {
            let cur = self.table_get(obj.i, key);
            if cur.tag == VT_NIL {
                let meta = self.tables[obj.i].meta;
                if meta >= 0 {
                    let ni = self.table_get_str(meta, s_from(STR_PTR("__newindex"), 10));
                    if ni.tag == VT_TABLE {
                        self.set_index(ni, key, val);
                        return;
                    };
                    if ni.tag == VT_FUNC || ni.tag == VT_BUILTIN {
                        let cargs = Vec::new();
                        cargs.push(obj);
                        cargs.push(key);
                        cargs.push(val);
                        self.call_value(ni, cargs);
                        return;
                    };
                };
            };
            self.table_set(obj.i, key, val);
            return;
        };
        self.fail_str(STR_PTR("attempt to index a non-table value"), 34);
    }

    fn arith_op_name(&self, op: i64) -> u64 {
        if op == TK_ADD {
            return s_from(STR_PTR("add"), 3);
        };
        if op == TK_SUB {
            return s_from(STR_PTR("sub"), 3);
        };
        if op == TK_MUL {
            return s_from(STR_PTR("mul"), 3);
        };
        if op == TK_DIV {
            return s_from(STR_PTR("div"), 3);
        };
        if op == TK_MOD {
            return s_from(STR_PTR("mod"), 3);
        };
        if op == TK_IDIV {
            return s_from(STR_PTR("idiv"), 4);
        };
        if op == TK_POW {
            return s_from(STR_PTR("pow"), 3);
        };
        return s_from(STR_PTR("perform arithmetic on"), 21);
    }

    fn arith_error_msg(&self, op: i64, t1: u64, t2: u64, str_mode: bool) -> u64 {
        if str_mode {
            let m1 = s_cat(s_cat(s_from(STR_PTR("attempt to "), 11), self.arith_op_name(op)), s_from(STR_PTR(" a '"), 4));
            let m2 = s_cat(s_cat(m1, t1), s_from(STR_PTR("' with a '"), 10));
            let m3 = s_cat(m2, t2);
            return s_cat(m3, s_from(STR_PTR("'"), 1));
        };
        let m4 = s_cat(s_from(STR_PTR("attempt to perform arithmetic on a "), 35), t1);
        return s_cat(m4, s_from(STR_PTR(" value"), 6));
    }

    fn mm_exists(&self, name: u64, a: Value, b: Value) -> bool {
        let ma = self.metatable_of(a);
        if ma >= 0 {
            let f = self.table_get(ma, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                return true;
            };
        };
        let mb = self.metatable_of(b);
        if mb >= 0 {
            let f = self.table_get(mb, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                return true;
            };
        };
        return false;
    }

    fn to_int_exact(&self, v: Value) -> Value {
        if v.tag == VT_INT {
            return v;
        };
        if v.tag == VT_NUM {
            let i = v.f as i64;
            if (i as f64) == v.f {
                return v_int(i);
            };
        };
        return v_nil();
    }

    fn is_bitwise_op(&self, op: i64) -> bool {
        if op == TK_AMP || op == TK_PIPE || op == TK_TILDE {
            return true;
        };
        if op == TK_SHL || op == TK_SHR {
            return true;
        };
        return false;
    }

    fn bit_error_msg(&self, a: Value, b: Value) -> u64 {
        let t1 = v_type_name(a);
        let m1 = s_cat(s_from(STR_PTR("attempt to perform bitwise operation on a "), 42), t1);
        return s_cat(m1, s_from(STR_PTR(" value"), 6));
    }

    fn num_bin(&self, op: i64, a: Value, b: Value) -> Value {
        let str_mode = a.tag == VT_STR || b.tag == VT_STR;
        let t1 = v_type_name(a);
        let t2 = v_type_name(b);
        if self.is_bitwise_op(op) {
            let ai = self.to_int_exact(a);
            let bi = self.to_int_exact(b);
            if ai.tag == VT_INT && bi.tag == VT_INT {
                return self.bitwise_op(op, ai, bi);
            };
            let mm = self.bin_mm_name(op);
            if mm != 0 {
                if self.mm_exists(mm, a, b) {
                    return self.mm_bin(mm, a, b);
                };
            };
            if a.tag == VT_NUM || b.tag == VT_NUM {
                self.fail_str(STR_PTR("number has no integer representation"), 36);
                return v_nil();
            };
            self.fail_text(self.bit_error_msg(a, b));
            return v_nil();
        };
        a = self.v_coerce_num(a);
        b = self.v_coerce_num(b);
        if v_is_number(a) == false || v_is_number(b) == false {
            let mm = self.bin_mm_name(op);
            if mm != 0 {
                if self.mm_exists(mm, a, b) {
                    return self.mm_bin(mm, a, b);
                };
            };
            self.fail_text(self.arith_error_msg(op, t1, t2, str_mode));
            return v_nil();
        };
        let both = a.tag == VT_INT && b.tag == VT_INT;
        if op == TK_ADD {
            if both {
                return v_int(a.i + b.i);
            };
            return v_num(v_as_num(a) + v_as_num(b));
        };
        if op == TK_SUB {
            if both {
                return v_int(a.i - b.i);
            };
            return v_num(v_as_num(a) - v_as_num(b));
        };
        if op == TK_MUL {
            if both {
                return v_int(a.i * b.i);
            };
            return v_num(v_as_num(a) * v_as_num(b));
        };
        if op == TK_DIV {
            let d = v_as_num(b);
            return v_num(v_as_num(a) / d);
        };
        if op == TK_IDIV {
            if both {
                if b.i == 0 {
                    self.fail_str(STR_PTR("attempt to divide by zero"), 25);
                    return v_nil();
                };
                if b.i == -1 {
                    return v_int(0 - a.i);
                };
                let q = a.i / b.i;
                if b.i == -1 {
                    return v_int(0);
                };
                let r = a.i % b.i;
                if r != 0 && ((r < 0) != (b.i < 0)) {
                    q = q - 1;
                };
                return v_int(q);
            };
            let d = v_as_num(b);
            return v_num(sa_math_floor(v_as_num(a) / d));
        };
        if op == TK_MOD {
            if both {
                if b.i == 0 {
                    self.fail_str(STR_PTR("attempt to perform 'n%%0'"), 25);
                    return v_nil();
                };
                let r = a.i % b.i;
                if r != 0 && ((r < 0) != (b.i < 0)) {
                    r = r + b.i;
                };
                return v_int(r);
            };
            let d = v_as_num(b);
            let r = v_as_num(a) - sa_math_floor(v_as_num(a) / d) * d;
            return v_num(r);
        };
        if op == TK_POW {
            return v_num(sa_math_pow(v_as_num(a), v_as_num(b)));
        };
        return v_nil();
    }

    fn bitwise_op(&self, op: i64, a: Value, b: Value) -> Value {
        if op == TK_AMP {
            return v_int(a.i & b.i);
        };
        if op == TK_PIPE {
            return v_int(a.i | b.i);
        };
        if op == TK_TILDE {
            return v_int(a.i ^ b.i);
        };
        let x = a.i;
        let n = b.i;
        let left = op == TK_SHL;
        if n < 0 {
            if n <= -64 {
                return v_int(0);
            };
            left = left == false;
            n = 0 - n;
        };
        if n >= 64 {
            return v_int(0);
        };
        if left {
            return v_int(((x as u64) << (n as u64)) as i64);
        };
        return v_int(((x as u64) >> (n as u64)) as i64);
    }

    fn metatable_of(&self, v: Value) -> i64 {
        if v.tag == VT_TABLE {
            return self.tables[v.i].meta;
        };
        if v.tag == VT_STR {
            let sm = self.table_get_str(self.globals, s_from(STR_PTR("__strmeta"), 9));
            if sm.tag == VT_TABLE {
                return sm.i;
            };
        };
        return -1;
    }

    fn bin_mm_name(&self, op: i64) -> u64 {
        if op == TK_ADD { return s_from(STR_PTR("__add"), 5); };
        if op == TK_SUB { return s_from(STR_PTR("__sub"), 5); };
        if op == TK_MUL { return s_from(STR_PTR("__mul"), 5); };
        if op == TK_DIV { return s_from(STR_PTR("__div"), 5); };
        if op == TK_IDIV { return s_from(STR_PTR("__idiv"), 6); };
        if op == TK_MOD { return s_from(STR_PTR("__mod"), 5); };
        if op == TK_POW { return s_from(STR_PTR("__pow"), 5); };
        if op == TK_AMP { return s_from(STR_PTR("__band"), 6); };
        if op == TK_PIPE { return s_from(STR_PTR("__bor"), 5); };
        if op == TK_TILDE { return s_from(STR_PTR("__bxor"), 6); };
        if op == TK_SHL { return s_from(STR_PTR("__shl"), 5); };
        if op == TK_SHR { return s_from(STR_PTR("__shr"), 5); };
        return 0;
    }

    fn mm_bin(&self, name: u64, a: Value, b: Value) -> Value {
        let ma = self.metatable_of(a);
        if ma >= 0 {
            let f = self.table_get(ma, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                let args = Vec::new();
                args.push(a);
                args.push(b);
                let out = self.call_value(f, args);
                if len(out) > 0 {
                    return out[0];
                };
            };
        };
        let mb = self.metatable_of(b);
        if mb >= 0 {
            let f = self.table_get(mb, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                let args = Vec::new();
                args.push(a);
                args.push(b);
                let out = self.call_value(f, args);
                if len(out) > 0 {
                    return out[0];
                };
            };
        };
        self.fail_str(STR_PTR("attempt to perform arithmetic on a non-number value"), 51);
        return v_nil();
    }

    fn mm_un(&self, name: u64, a: Value) -> Value {
        let ma = self.metatable_of(a);
        if ma >= 0 {
            let f = self.table_get(ma, v_str(name));
            if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                let args = Vec::new();
                args.push(a);
                let out = self.call_value(f, args);
                if len(out) > 0 {
                    return out[0];
                };
            };
        };
        self.fail_str(STR_PTR("attempt to perform arithmetic on a non-number value"), 51);
        return v_nil();
    }

    fn eval_bin(&self, env: i64, nd: Node) -> Value {
        if nd.n == KW_AND {
            let a = self.eval(env, nd.a);
            if v_truthy(a) == false {
                return a;
            };
            return self.eval(env, nd.b);
        };
        if nd.n == KW_OR {
            let a = self.eval(env, nd.a);
            if v_truthy(a) {
                return a;
            };
            return self.eval(env, nd.b);
        };
        let a = self.eval(env, nd.a);
        let b = self.eval(env, nd.b);
        if self.ctrl == CTL_ERROR {
            return v_nil();
        };
        if nd.n == TK_CONCAT {
            return v_str(s_cat(v_to_string(a), v_to_string(b)));
        };
        if nd.n == TK_EQ {
            return v_bool(v_equal(&a, &b));
        };
        if nd.n == TK_NE {
            return v_bool(v_equal(&a, &b) == false);
        };
        if nd.n == TK_LT || nd.n == TK_LE || nd.n == TK_GT || nd.n == TK_GE {
            let c = 0;
            if a.tag == VT_STR && b.tag == VT_STR {
                c = s_cmp(a.s, b.s);
            } else {
                if v_is_number(a) && v_is_number(b) {
                    c = v_cmp_num(&a, &b);
                } else {
                    self.fail_str(STR_PTR("attempt to compare values"), 25);
                    return v_nil();
                }
            };
            if nd.n == TK_LT {
                return v_bool(c == -1);
            };
            if nd.n == TK_LE {
                return v_bool(c == -1 || c == 0);
            };
            if nd.n == TK_GT {
                return v_bool(c == 1);
            };
            return v_bool(c == 0 || c == 1);
        };
        return self.num_bin(nd.n, a, b);
    }

    fn eval_un(&self, env: i64, nd: Node) -> Value {
        let v = self.eval(env, nd.a);
        if nd.n == KW_NOT {
            return v_bool(v_truthy(v) == false);
        };
        if nd.n == TK_SUB {
            if v.tag == VT_INT {
                return v_int(0 - v.i);
            };
            if v.tag == VT_NUM {
                return v_num(0.0 - v.f);
            };
            return self.mm_un(s_from(STR_PTR("__unm"), 5), v);
        };
        if nd.n == TK_HASH {
            if v.tag == VT_STR {
                return v_int(s_len(v.s) as i64);
            };
            if v.tag == VT_TABLE {
                return v_int(self.table_len(v.i));
            };
            self.fail_str(STR_PTR("attempt to get length of a value"), 32);
            return v_nil();
        };
        if nd.n == TK_TILDE {
            if v_is_number(v) {
                return v_int(v_to_i64(v) ^ (-1));
            };
            return self.mm_un(s_from(STR_PTR("__bnot"), 6), v);
        };
        return v_nil();
    }

    fn call_value(&self, f: Value, args: Vec<Value>) -> Vec<Value> {
        if f.tag == VT_FUNC {
            return self.call_lua(f.i, args);
        };
        if f.tag == VT_BUILTIN {
            return self.builtin_call(f.i, args);
        };
        self.fail_str(STR_PTR("attempt to call a non-function value"), 36);
        return Vec::new();
    }

    fn call_lua(&self, fid: i64, args: Vec<Value>) -> Vec<Value> {
        let env = self.new_env(self.funcs[fid].env);
        let nparams = len(self.funcs[fid].params) as i64;
        let ai = 0;
        if self.funcs[fid].has_self != 0 {
            let sv = v_nil();
            if len(args) > 0 {
                sv = args[0];
            };
            self.env_define(env, s_from(STR_PTR("self"), 4), sv, 0);
            ai = 1;
        };
        let i = 0;
        while i < nparams {
            let pid = self.funcs[fid].params[i];
            let pn = self.nd(pid);
            if pn.n == 4 {
                let t = self.new_table();
                let j = ai;
                let idx = 1;
                let mem_before = self.mem_used;
                while j < (len(args) as i64) {
                    self.table_set(t, v_int(idx), args[j]);
                    idx = idx + 1;
                    j = j + 1;
                }
                self.mem_used = mem_before;
                self.table_set_str(t, s_from(STR_PTR("n"), 1), v_int(idx - 1));
                self.mem_used = mem_before;
                self.envs[env].vargname = pn.s;
                self.env_define(env, pn.s, v_table(t), 0);
            } else {
                let av = v_nil();
                if ai < (len(args) as i64) {
                    av = args[ai];
                    ai = ai + 1;
                };
                self.env_define(env, pn.s, av, 0);
            };
            i = i + 1;
        }
        let va = Vec::new();
        while ai < (len(args) as i64) {
            va.push(args[ai]);
            ai = ai + 1;
        }
        self.envs[env].varargs = va;
        self.ctrl = CTL_NONE;
        self.retvals = Vec::new();
        let saved_line = self.curline;
        self.exec_block(env, self.funcs[fid].body);
        self.curline = saved_line;
        let out = self.take_returns();
        if self.ctrl == CTL_RETURN {
            self.ctrl = CTL_NONE;
        };
        return out;
    }
}
