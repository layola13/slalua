@import "sa_std/vec.sa"
@import "sa_std/string.sa"
@import "sa_std/math.sai"
@import "src/tok.sla"
@import "src/ast.sla"
@import "src/value.sla"
@import "src/strutil.sla"
@import "src/interp_core.sla"
@import "src/interp_stmt.sla"
@import "src/builtins.sla"
@import "src/interp_arith.sla"

fn v_is_integral(v: Value) -> bool {
    if v.tag == VT_INT {
        return true;
    };
    if v.tag == VT_NUM {
        return v.f == ((v.f as i64) as f64);
    };
    return false;
}

fn v_to_i64(v: Value) -> i64 {
    if v.tag == VT_INT {
        return v.i;
    };
    return v.f as i64;
}

impl Interp {
    fn eval(&self, env: i64, id: i64) -> Value {
        let nd = self.nd(id);
        if nd.kind == NK_NIL {
            return v_nil();
        };
        if nd.kind == NK_TRUE {
            return v_bool(true);
        };
        if nd.kind == NK_FALSE {
            return v_bool(false);
        };
        if nd.kind == NK_INT {
            return v_int(nd.n);
        };
        if nd.kind == NK_NUM {
            return v_num(nd.f);
        };
        if nd.kind == NK_STR {
            return v_str(nd.s);
        };
        if nd.kind == NK_NAME {
            return self.env_get(env, nd.s);
        };
        if nd.kind == NK_VARARG {
            let vn = self.env_vargname(env);
            if vn != 0 {
                let t = self.env_get(env, vn);
                if t.tag == VT_TABLE {
                    let nv = self.vararg_n(t.i);
                    if nv < 1 {
                        return v_nil();
                    };
                    return self.table_get(t.i, v_int(1));
                };
                return v_nil();
            };
            if len(self.envs[env].varargs) > 0 {
                return self.envs[env].varargs[0];
            };
            return v_nil();
        };
        if nd.kind == NK_PAREN {
            return self.eval(env, nd.a);
        };
        if nd.kind == NK_INDEX {
            let obj = self.eval(env, nd.a);
            let key = v_str(nd.s);
            if nd.b != 0 {
                key = self.eval(env, nd.b);
            };
            return self.get_index(obj, key);
        };
        if nd.kind == NK_CALL || nd.kind == NK_METHOD {
            let out = self.eval_call(env, id);
            if len(out) > 0 {
                return out[0];
            };
            return v_nil();
        };
        if nd.kind == NK_FUNC {
            return v_func(self.make_func(env, id));
        };
        if nd.kind == NK_TABLE {
            return self.make_table(env, id);
        };
        if nd.kind == NK_BIN {
            return self.eval_bin(env, nd);
        };
        if nd.kind == NK_UN {
            return self.eval_un(env, nd);
        };
        return v_nil();
    }

    fn eval_call(&self, env: i64, id: i64) -> Vec<Value> {
        let nd = self.nd(id);
        self.curline = nd.line;
        if nd.kind == NK_CALL {
            let f = self.eval(env, nd.a);
            let args = self.eval_list(env, nd.b);
            return self.call_value(f, args);
        };
        let obj = self.eval(env, nd.a);
        let f = self.get_index(obj, v_str(nd.s));
        let args = self.eval_list(env, nd.b);
        let all = Vec::new();
        all.push(obj);
        let i = 0;
        while i < (len(args) as i64) {
            all.push(args[i]);
            i = i + 1;
        }
        return self.call_value(f, all);
    }

    fn vararg_n(&self, t: i64) -> i64 {
        let cnt = self.table_get_str(t, s_from(STR_PTR("n"), 1));
        if cnt.tag != VT_INT {
            self.fail_str(STR_PTR("no proper 'n'"), 13);
            return 0;
        };
        if cnt.i < 0 || cnt.i > 1048576 {
            self.fail_str(STR_PTR("no proper 'n'"), 13);
            return 0;
        };
        return cnt.i;
    }

    fn eval_multi(&self, env: i64, id: i64) -> Vec<Value> {
        let out = Vec::new();
        let nd = self.nd(id);
        if nd.kind == NK_CALL || nd.kind == NK_METHOD {
            return self.eval_call(env, id);
        };
        if nd.kind == NK_VARARG {
            let vn = self.env_vargname(env);
            if vn != 0 {
                let t = self.env_get(env, vn);
                if t.tag != VT_TABLE {
                    return out;
                };
                let nv = self.vararg_n(t.i);
                let i = 1;
                while i <= nv {
                    out.push(self.table_get(t.i, v_int(i)));
                    i = i + 1;
                }
                return out;
            };
            let i = 0;
            while i < (len(self.envs[env].varargs) as i64) {
                out.push(self.envs[env].varargs[i]);
                i = i + 1;
            }
            return out;
        };
        out.push(self.eval(env, id));
        return out;
    }

    fn eval_list(&self, env: i64, lid: i64) -> Vec<Value> {
        let out = Vec::new();
        let n = self.list_len(lid);
        let i = 0;
        while i < n {
            let vals = self.eval_multi(env, self.list_get(lid, i));
            if i == n - 1 {
                let j = 0;
                while j < (len(vals) as i64) {
                    out.push(vals[j]);
                    j = j + 1;
                }
            } else {
                if len(vals) > 0 {
                    out.push(vals[0]);
                } else {
                    out.push(v_nil());
                }
            };
            i = i + 1;
        }
        return out;
    };

    fn make_func(&self, env: i64, id: i64) -> i64 {
        let nd = self.nd(id);
        let ps = Vec::new();
        let n = self.list_len(nd.a);
        let i = 0;
        while i < n {
            ps.push(self.list_get(nd.a, i));
            i = i + 1;
        }
        return self.new_func(ps, nd.b, nd.n, nd.d, env);
    }

    fn make_table(&self, env: i64, id: i64) -> Value {
        let nd = self.nd(id);
        let tid = self.new_table();
        let n = self.list_len(nd.a);
        let i = 0;
        let seq = 1;
        while i < n {
            let fid = self.list_get(nd.a, i);
            let f = self.nd(fid);
            let key = v_nil();
            let val = v_nil();
            if f.n == 1 {
                key = self.eval(env, f.a);
                val = self.eval(env, f.b);
            };
            if f.n == 2 {
                key = v_str(f.s);
                val = self.eval(env, f.b);
            };
            if f.n == 0 {
                let expand = false;
                if i == n - 1 {
                    let ex = self.nd(f.b);
                    if ex.kind == NK_VARARG || ex.kind == NK_CALL || ex.kind == NK_METHOD {
                        expand = true;
                    };
                };
                if expand {
                    let vals = self.eval_multi(env, f.b);
                    let j = 0;
                    while j < (len(vals) as i64) {
                        self.table_set(tid, v_int(seq), vals[j]);
                        seq = seq + 1;
                        j = j + 1;
                    }
                    i = i + 1;
                    continue;
                };
                val = self.eval(env, f.b);
                key = v_int(seq);
                seq = seq + 1;
            };
            self.table_set(tid, key, val);
            i = i + 1;
        }
        return v_table(tid);
    }

    fn get_index(&self, obj: Value, key: Value) -> Value {
        if self.index_depth > 100 {
            self.fail_str(STR_PTR("loop in gettable"), 16);
            return v_nil();
        };
        self.index_depth = self.index_depth + 1;
        let r = self.get_index_raw(obj, key);
        self.index_depth = self.index_depth - 1;
        return r;
    }

    fn get_index_raw(&self, obj: Value, key: Value) -> Value {
        if obj.tag == VT_TABLE {
            let v = self.table_get(obj.i, key);
            if v.tag != VT_NIL {
                return v;
            };
            let meta = self.tables[obj.i].meta;
            if meta >= 0 {
                let idx = self.table_get_str(meta, s_from(STR_PTR("__index"), 7));
                if idx.tag == VT_TABLE {
                    return self.get_index(idx, key);
                };
                if idx.tag == VT_FUNC || idx.tag == VT_BUILTIN {
                    let cargs = Vec::new();
                    cargs.push(obj);
                    cargs.push(key);
                    let out = self.call_value(idx, cargs);
                    if len(out) > 0 {
                        return out[0];
                    };
                };
            };
            return v_nil();
        };
        if obj.tag == VT_STR {
            let st = self.table_get_str(self.globals, s_from(STR_PTR("string"), 6));
            if st.tag == VT_TABLE {
                let sv = self.table_get(st.i, key);
                if sv.tag != VT_NIL {
                    return sv;
                };
            };
        };
        let tmeta = self.type_meta(v_type_name(obj));
        if tmeta >= 0 {
            let idx = self.table_get_str(tmeta, s_from(STR_PTR("__index"), 7));
            if idx.tag == VT_TABLE {
                return self.get_index(idx, key);
            };
            if idx.tag == VT_FUNC || idx.tag == VT_BUILTIN {
                let cargs = Vec::new();
                cargs.push(obj);
                cargs.push(key);
                let out = self.call_value(idx, cargs);
                if len(out) > 0 {
                    return out[0];
                };
            };
        };
        self.fail_str(STR_PTR("attempt to index a non-table value"), 34);
        return v_nil();
    }

    fn one_arg(&self, a: Value, b: Value) -> Vec<Value> {
        let out = Vec::new();
        out.push(a);
        return out;
    }

    fn set_index(&self, obj: Value, key: Value, val: Value) -> void {
        if self.index_depth > 100 {
            self.fail_str(STR_PTR("loop in settable"), 16);
            return;
        };
        self.index_depth = self.index_depth + 1;
        self.set_index_raw(obj, key, val);
        self.index_depth = self.index_depth - 1;
    }

    fn set_index_raw(&self, obj: Value, key: Value, val: Value) -> void {
        if obj.tag == VT_TABLE {
            let cur = self.table_get(obj.i, key);
            if cur.tag == VT_NIL {
                let meta = self.tables[obj.i].meta;
                if meta >= 0 {
                    let ni = self.table_get_str(meta, s_from(STR_PTR("__newindex"), 10));
                    if ni.tag == VT_TABLE {
                        self.set_index(ni, key, val);
                        return;
                    };
                    if ni.tag == VT_FUNC || ni.tag == VT_BUILTIN {
                        let cargs = Vec::new();
                        cargs.push(obj);
                        cargs.push(key);
                        cargs.push(val);
                        self.call_value(ni, cargs);
                        return;
                    };
                };
            };
            self.table_set(obj.i, key, val);
            return;
        };
        self.fail_str(STR_PTR("attempt to index a non-table value"), 34);
    }


    fn eval_bin(&self, env: i64, nd: Node) -> Value {
        if nd.n == KW_AND {
            let a = self.eval(env, nd.a);
            if v_truthy(a) == false {
                return a;
            };
            return self.eval(env, nd.b);
        };
        if nd.n == KW_OR {
            let a = self.eval(env, nd.a);
            if v_truthy(a) {
                return a;
            };
            return self.eval(env, nd.b);
        };
        let a = self.eval(env, nd.a);
        let b = self.eval(env, nd.b);
        if self.ctrl == CTL_ERROR {
            return v_nil();
        };
        if nd.n == TK_CONCAT {
            let an = a.tag == VT_STR || a.tag == VT_INT || a.tag == VT_NUM;
            let bn = b.tag == VT_STR || b.tag == VT_INT || b.tag == VT_NUM;
            if an && bn {
                return v_str(s_cat(v_to_string(a), v_to_string(b)));
            };
            let nm = s_from(STR_PTR("__concat"), 8);
            if self.mm_exists(nm, value_new(a.tag, a.i, a.f, a.s), value_new(b.tag, b.i, b.f, b.s)) {
                return self.mm_bin(nm, value_new(a.tag, a.i, a.f, a.s), value_new(b.tag, b.i, b.f, b.s));
            };
            self.fail_str(STR_PTR("attempt to concatenate a non-string value"), 41);
            return v_nil();
        };
        if nd.n == TK_EQ || nd.n == TK_NE {
            let eq = v_equal(&a, &b);
            if eq == false && a.tag == b.tag && a.tag == VT_TABLE {
                let nm = s_from(STR_PTR("__eq"), 4);
                if self.mm_exists(nm, value_new(a.tag, a.i, a.f, a.s), value_new(b.tag, b.i, b.f, b.s)) {
                    let r = self.mm_bin(nm, value_new(a.tag, a.i, a.f, a.s), value_new(b.tag, b.i, b.f, b.s));
                    eq = v_truthy(r);
                };
            };
            if nd.n == TK_NE {
                eq = eq == false;
            };
            return v_bool(eq);
        };
        if nd.n == TK_LT || nd.n == TK_LE || nd.n == TK_GT || nd.n == TK_GE {
            let c = 0;
            if a.tag == VT_STR && b.tag == VT_STR {
                c = s_cmp(a.s, b.s);
            } else if v_is_number(a) && v_is_number(b) {
                c = v_cmp_num(&a, &b);
            } else {
                let rev = nd.n == TK_GT || nd.n == TK_GE;
                let ra = value_new(a.tag, a.i, a.f, a.s);
                let rb = value_new(b.tag, b.i, b.f, b.s);
                if rev {
                    ra = value_new(b.tag, b.i, b.f, b.s);
                    rb = value_new(a.tag, a.i, a.f, a.s);
                };
                let isle = nd.n == TK_LE || nd.n == TK_GE;
                let mm = s_from(STR_PTR("__lt"), 4);
                if isle {
                    mm = s_from(STR_PTR("__le"), 4);
                };
                if self.mm_exists(mm, value_new(ra.tag, ra.i, ra.f, ra.s), value_new(rb.tag, rb.i, rb.f, rb.s)) {
                    let r = self.mm_bin(mm, value_new(ra.tag, ra.i, ra.f, ra.s), value_new(rb.tag, rb.i, rb.f, rb.s));
                    return v_bool(v_truthy(r));
                };
                if isle {
                    let lt = s_from(STR_PTR("__lt"), 4);
                    if self.mm_exists(lt, value_new(rb.tag, rb.i, rb.f, rb.s), value_new(ra.tag, ra.i, ra.f, ra.s)) {
                        let r = self.mm_bin(lt, value_new(rb.tag, rb.i, rb.f, rb.s), value_new(ra.tag, ra.i, ra.f, ra.s));
                        return v_bool(v_truthy(r) == false);
                    };
                };
                self.fail_str(STR_PTR("attempt to compare values"), 25);
                return v_nil();
            };
            if nd.n == TK_LT {
                return v_bool(c == -1);
            };
            if nd.n == TK_LE {
                return v_bool(c == -1 || c == 0);
            };
            if nd.n == TK_GT {
                return v_bool(c == 1);
            };
            return v_bool(c == 0 || c == 1);
        };
        return self.num_bin(nd.n, a, b);
    };

    fn eval_un(&self, env: i64, nd: Node) -> Value {
        let v = self.eval(env, nd.a);
        if nd.n == KW_NOT {
            return v_bool(v_truthy(v) == false);
        };
        if nd.n == TK_SUB {
            let ov = value_new(v.tag, v.i, v.f, v.s);
            let cv = self.v_coerce_num(v);
            if cv.tag == VT_INT {
                return v_int(0 - cv.i);
            };
            if cv.tag == VT_NUM {
                return v_num(0.0 - cv.f);
            };
            return self.mm_un(s_from(STR_PTR("__unm"), 5), ov);
        };
        if nd.n == TK_HASH {
            if v.tag == VT_STR {
                return v_int(s_len(v.s) as i64);
            };
            if v.tag == VT_TABLE {
                let meta = self.tables[v.i].meta;
                if meta >= 0 {
                    let f = self.table_get(meta, v_str(s_from(STR_PTR("__len"), 5)));
                    if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                        return self.mm_un(s_from(STR_PTR("__len"), 5), v);
                    };
                };
                return v_int(self.table_len(v.i));
            };
            let tmeta = self.type_meta(v_type_name(v));
            if tmeta >= 0 {
                let f = self.table_get_str(tmeta, s_from(STR_PTR("__len"), 5));
                if f.tag == VT_FUNC || f.tag == VT_BUILTIN {
                    return self.mm_un(s_from(STR_PTR("__len"), 5), v);
                };
            };
            self.fail_str(STR_PTR("attempt to get length of a value"), 32);
            return v_nil();
        };
        if nd.n == TK_TILDE {
            let ov = value_new(v.tag, v.i, v.f, v.s);
            let cv = self.v_coerce_num(v);
            if v_is_number(cv) {
                return v_int(v_to_i64(cv) ^ (-1));
            };
            return self.mm_un(s_from(STR_PTR("__bnot"), 6), ov);
        };
        return v_nil();
    }

    fn call_value(&self, f: Value, args: Vec<Value>) -> Vec<Value> {
        if f.tag == VT_FUNC {
            return self.call_lua(f.i, args);
        };
        if f.tag == VT_BUILTIN {
            return self.builtin_call(f.i, args);
        };
        if f.tag == VT_TABLE {
            let meta = self.tables[f.i].meta;
            if meta >= 0 {
                let call = self.table_get_str(meta, s_from(STR_PTR("__call"), 6));
                if call.tag == VT_FUNC || call.tag == VT_BUILTIN {
                    let cargs = Vec::new();
                    cargs.push(f);
                    let i = 0;
                    while i < (len(args) as i64) {
                        cargs.push(args[i]);
                        i = i + 1;
                    }
                    return self.call_value(call, cargs);
                };
            };
        };
        self.fail_str(STR_PTR("attempt to call a non-function value"), 36);
        return Vec::new();
    }

    fn call_lua(&self, fid: i64, args: Vec<Value>) -> Vec<Value> {
        self.depth = self.depth + 1;
        if self.depth > 195 {
            self.depth = self.depth - 1;
            if self.in_error != 0 {
                self.fail_text(s_from(STR_PTR("error in error handling"), 23));
            } else {
                self.fail_text(s_from(STR_PTR("stack overflow"), 14));
            };
            return Vec::new();
        };
        self.tail_args = args;
        let cur_fid = fid;
        let out = Vec::new();
        let going = true;
        while going {
            let env = self.new_env(self.funcs[cur_fid].env);
            let nparams = len(self.funcs[cur_fid].params) as i64;
            let ai = 0;
            if self.funcs[cur_fid].has_self != 0 {
                let sv = v_nil();
                if len(self.tail_args) > 0 {
                    sv = self.tail_args[0];
                };
                self.env_define(env, s_from(STR_PTR("self"), 4), sv, 0);
                ai = 1;
            };
            let i = 0;
            while i < nparams {
                let pid = self.funcs[cur_fid].params[i];
                let pn = self.nd(pid);
                if pn.n == 4 {
                    let t = self.new_table();
                    let j = ai;
                    let idx = 1;
                    let mem_before = self.mem_used;
                    while j < (len(self.tail_args) as i64) {
                        self.table_set(t, v_int(idx), self.tail_args[j]);
                        idx = idx + 1;
                        j = j + 1;
                    }
                    self.mem_used = mem_before;
                    self.table_set_str(t, s_from(STR_PTR("n"), 1), v_int(idx - 1));
                    self.mem_used = mem_before;
                    self.envs[env].vargname = pn.s;
                    self.env_define(env, pn.s, v_table(t), 0);
                } else {
                    let av = v_nil();
                    if ai < (len(self.tail_args) as i64) {
                        av = self.tail_args[ai];
                        ai = ai + 1;
                    };
                    self.env_define(env, pn.s, av, 0);
                };
                i = i + 1;
            }
            let va = Vec::new();
            while ai < (len(self.tail_args) as i64) {
                va.push(self.tail_args[ai]);
                ai = ai + 1;
            }
            self.envs[env].varargs = va;
            self.ctrl = CTL_NONE;
            self.retvals = Vec::new();
            let saved_line = self.curline;
            self.exec_block(env, self.funcs[cur_fid].body);
            self.curline = saved_line;
            if self.tail_flag == 1 {
                self.tail_flag = 0;
                cur_fid = cur_fid + (self.tail_fid - cur_fid);
                continue;
            };
            let res = self.take_returns();
            if self.ctrl == CTL_RETURN {
                self.ctrl = CTL_NONE;
            };
            self.depth = self.depth - 1;
            return res;
        }
        self.depth = self.depth - 1;
        return out;
    }
};
