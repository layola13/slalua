@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sa"
@import "sa_std/string.sai"
@import "sa_std/ptr.sa"
@import "src/rt.sa"
@import "src/libm.sai"

fn s_len(s: u64) -> u64 {
    return sa_fmt_buffer_len(s);
}

fn s_byte(s: u64, i: u64) -> u8 {
    let p = sa_fmt_buffer_data(s);
    return SLA_BYTE_AT(p, i);
}

fn s_eq(a: u64, b: u64) -> bool {
    let an = sa_fmt_buffer_len(a);
    let bn = sa_fmt_buffer_len(b);
    if an != bn {
        return false;
    };
    let ap = sa_fmt_buffer_data(a);
    let bp = sa_fmt_buffer_data(b);
    let i: u64 = 0;
    let ok = true;
    while i < an {
        let ca = SLA_BYTE_AT(ap, i);
        let cb = SLA_BYTE_AT(bp, i);
        if ca != cb {
            ok = false;
            i = an;
        } else {
            i = i + 1;
        };
    }
    return ok;
};

fn s_eq_lit(a: u64, lit: ptr, lit_len: u64) -> bool {
    let an = sa_fmt_buffer_len(a);
    if an != lit_len {
        return false;
    };
    let ap = sa_fmt_buffer_data(a);
    let i: u64 = 0;
    let ok = true;
    while i < an {
        let ca = SLA_BYTE_AT(ap, i);
        let cb = SLA_BYTE_AT(lit, i);
        if ca != cb {
            ok = false;
            i = an;
        } else {
            i = i + 1;
        };
    }
    return ok;
};

fn s_cmp(a: u64, b: u64) -> i64 {
    let an = s_len(a);
    let bn = s_len(b);
    let n = an;
    if bn < n {
        n = bn;
    };
    let i: u64 = 0;
    while i < n {
        let ca = s_byte(a, i);
        let cb = s_byte(b, i);
        if ca < cb {
            return -1;
        };
        if ca > cb {
            return 1;
        };
        i = i + 1;
    }
    if an < bn {
        return -1;
    };
    if an > bn {
        return 1;
    };
    return 0;
}

fn s_slice(s: u64, start: u64, n: u64) -> u64 {
    return SLA_BUF_SLICE(s, start, n);
}

fn s_cat(a: u64, b: u64) -> u64 {
    return SLA_BUF_CONCAT(a, b);
}

fn s_i64(v: i64) -> u64 {
    return sa_fmt_i64(v, 10);
}

fn s_f64(v: f64) -> u64 {
    return sa_fmt_f64(v, 14);
}

fn s_hex(v: u64) -> u64 {
    return sa_fmt_u64(v, 16);
}

fn s_utf8_esc(cp: i64) -> u64 {
    if cp < 128 {
        return s_char(cp as u8);
    };
    let out = s_from(STR_PTR(""), 0);
    let x = cp;
    let mfb = 63;
    let going = true;
    while going {
        out = s_cat(s_char((128 | (x & 63)) as u8), out);
        x = x >> 6;
        mfb = mfb >> 1;
        if x > mfb {
            going = true;
        } else {
            going = false;
        };
    }
    let first = ((0 - mfb - 1) << 1) | x;
    let b = first & 255;
    return s_cat(s_char(b as u8), out);
};

fn s_is_digit(c: u8) -> bool {
    if c >= 48 && c <= 57 {
        return true;
    };
    return false;
}

fn s_word_is(t: u64, pos: i64, len: i64, word: ptr) -> bool {
    let n = s_len(t) as i64;
    let i = 0;
    while i < len {
        if pos + i >= n {
            return false;
        };
        let c = s_byte(t, (pos + i) as u64);
        let w = SLA_BYTE_AT(word, i);
        let cl = c;
        if cl >= 65 && cl <= 90 {
            cl = cl + 32;
        };
        if cl != w {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn s_hex_digits(t: u64, pos: i64) -> i64 {
    let n = s_len(t) as i64;
    let i = pos;
    let cnt = 0;
    while i < n {
        let c = s_byte(t, i as u64);
        let ok = false;
        if c >= 48 && c <= 57 {
            ok = true;
        };
        if c >= 97 && c <= 102 {
            ok = true;
        };
        if c >= 65 && c <= 70 {
            ok = true;
        };
        if ok == false {
            break;
        };
        cnt = cnt + 1;
        i = i + 1;
    }
    return cnt;
}

fn s_num_valid(t: u64) -> bool {
    let n = s_len(t) as i64;
    let i = 0;
    if i < n {
        let c = s_byte(t, i as u64);
        if c == 43 || c == 45 {
            i = i + 1;
        };
    };
    if i >= n {
        return false;
    };
    let c0 = s_byte(t, i as u64);
    if c0 == 105 || c0 == 73 {
        return s_word_is(t, i, 3, STR_PTR("inf"));
    };
    if c0 == 110 || c0 == 78 {
        return s_word_is(t, i, 3, STR_PTR("nan"));
    };
    if c0 == 48 && i + 1 < n {
        let h = s_byte(t, (i + 1) as u64);
        if h == 120 || h == 88 {
            let j = i + 2;
            let cnt = s_hex_digits(t, j);
            if cnt == 0 {
                return false;
            };
            j = j + cnt;
            if j < n && s_byte(t, j as u64) == 46 {
                j = j + 1;
                let c2 = s_hex_digits(t, j);
                j = j + c2;
            };
            if j < n {
                let p = s_byte(t, j as u64);
                if p == 112 || p == 80 {
                    j = j + 1;
                    if j < n {
                        let sg = s_byte(t, j as u64);
                        if sg == 43 || sg == 45 {
                            j = j + 1;
                        };
                    };
                    let e = s_hex_digits(t, j);
                    j = j + e;
                    if e == 0 {
                        return false;
                    };
                };
            };
            return j == n;
        };
    };
    let digits = 0;
    while i < n && s_is_digit(s_byte(t, i as u64)) {
        i = i + 1;
        digits = digits + 1;
    }
    if i < n && s_byte(t, i as u64) == 46 {
        i = i + 1;
        while i < n && s_is_digit(s_byte(t, i as u64)) {
            i = i + 1;
            digits = digits + 1;
        }
    };
    if digits == 0 {
        return false;
    };
    if i < n {
        let e = s_byte(t, i as u64);
        if e == 101 || e == 69 {
            i = i + 1;
            if i < n {
                let sg = s_byte(t, i as u64);
                if sg == 43 || sg == 45 {
                    i = i + 1;
                };
            };
            let ed = 0;
            while i < n && s_is_digit(s_byte(t, i as u64)) {
                i = i + 1;
                ed = ed + 1;
            }
            if ed == 0 {
                return false;
            };
        };
    };
    return i == n;
}

fn utf8_encode(cp: i64) -> u64 {
    if cp < 128 {
        return s_char(cp as u8);
    };
    if cp < 2048 {
        let b1 = 192 | (cp >> 6);
        let b2 = 128 | (cp & 63);
        return s_cat(s_char(b1 as u8), s_char(b2 as u8));
    };
    if cp < 65536 {
        let b1 = 224 | (cp >> 12);
        let b2 = 128 | ((cp >> 6) & 63);
        let b3 = 128 | (cp & 63);
        let s1 = s_cat(s_char(b1 as u8), s_char(b2 as u8));
        return s_cat(s1, s_char(b3 as u8));
    };
    let b1 = 240 | (cp >> 18);
    let b2 = 128 | ((cp >> 12) & 63);
    let b3 = 128 | ((cp >> 6) & 63);
    let b4 = 128 | (cp & 63);
    let s1 = s_cat(s_char(b1 as u8), s_char(b2 as u8));
    let s2 = s_cat(s1, s_char(b3 as u8));
    return s_cat(s2, s_char(b4 as u8));
}

fn s_bool(v: bool) -> u64 {
    if v {
        return sa_fmt_bytes(STR_PTR("true"), 4);
    };
    return sa_fmt_bytes(STR_PTR("false"), 5);
}

fn s_from(p: ptr, n: u64) -> u64 {
    return sa_fmt_bytes(p, n);
}

fn s_char(c: u8) -> u64 {
    return SLA_CHAR_STR(c);
}

fn s_write(s: u64) -> void {
    SLA_PRINT_BUF(s);
}

fn s_put_i64(v: i64) -> void {
    let s = s_i64(v);
    s_write(s);
}

fn s_put_str(s: u64) -> void {
    s_write(s);
}

fn s_nl() -> void {
    println("");
}
