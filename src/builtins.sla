    fn builtin_call(&self, id: i64, args: Vec<Value>) -> Vec<Value> {
        if id == B_PRINT {
            let i = 0;
            while i < (len(args) as i64) {
                if i > 0 {
                    s_write(bs_str(STR_PTR(" "), 1));
                };
                s_write(v_to_string(args[i]));
                i = i + 1;
            }
            s_nl();
            return Vec::new();
        };
        if id == B_TYPE {
            if len(args) < 1 {
                self.fail_str(STR_PTR("bad argument #1 to 'type' (value expected)"), 42);
                return Vec::new();
            };
            let tv = bs_arg(&args, 0);
            if self.io_is_file(tv) {
                return bs_one(v_str(s_from(STR_PTR("userdata"), 8)));
            };
            return bs_one(v_str(v_type_name(tv)));
        };
        if id == B_TOSTRING {
            let tv = bs_arg(&args, 0);
            if self.io_is_file(tv) {
                return bs_one(v_str(self.io_file_string(tv.i)));
            };
            return bs_one(v_str(v_to_string(tv)));
        };
        if id == B_TONUMBER {
            if len(args) > 1 {
                return bs_one(self.bi_tonumber_base(bs_arg(&args, 0), bs_arg(&args, 1)));
            };
            return bs_one(self.bi_tonumber(bs_arg(&args, 0)));
        };
        if id == B_ASSERT {
            let a = bs_arg(&args, 0);
            if v_truthy(a) {
                return bs_copy(&args);
            };
            let m = v_str(bs_str(STR_PTR("assertion failed!"), 17));
            if len(args) > 1 {
                m = bs_arg(&args, 1);
            };
            if self.err == 0 {
                self.err = v_to_string(m);
            };
            self.ctrl = CTL_ERROR;
            return Vec::new();
        };
        if id == B_ERROR {
            let m = bs_arg(&args, 0);
            if m.tag == VT_NIL {
                self.err = bs_str(STR_PTR("<no error object>"), 17);
            } else {
                self.err = v_to_string(m);
            };
            self.ctrl = CTL_ERROR;
            return Vec::new();
        };
        if id == B_LOAD {
            return self.bi_load(&args);
        };
        if id == B_XPCALL {
            let f = bs_arg(&args, 0);
            let h = bs_arg(&args, 1);
            let rest = bs_rest(&args, 2);
            self.err = 0;
            self.ctrl = CTL_NONE;
            let out = self.call_value(f, rest);
            if self.err != 0 {
                let msg = self.err;
                self.err = 0;
                self.ctrl = CTL_NONE;
                let hr = Vec::new();
                hr.push(v_str(msg));
                self.in_error = self.in_error + 1;
                let ho = self.call_value(h, hr);
                self.in_error = self.in_error - 1;
                let r = Vec::new();
                r.push(v_bool(false));
                if self.err != 0 {
                    let hm = self.err;
                    self.err = 0;
                    self.ctrl = CTL_NONE;
                    r.push(v_str(hm));
                } else {
                    if len(ho) > 0 {
                        r.push(ho[0]);
                    } else {
                        r.push(v_str(msg));
                    };
                };
                return r;
            };
            let r = Vec::new();
            r.push(v_bool(true));
            let i = 0;
            while i < (len(out) as i64) {
                r.push(out[i]);
                i = i + 1;
            }
            return r;
        };
        if id == B_PCALL {
            let f = bs_arg(&args, 0);
            let rest = bs_rest(&args, 1);
            self.err = 0;
            self.ctrl = CTL_NONE;
            let out = self.call_value(f, rest);
            if self.err != 0 {
                let msg = self.err;
                self.err = 0;
                self.ctrl = CTL_NONE;
                let r = Vec::new();
                r.push(v_bool(false));
                r.push(v_str(msg));
                return r;
            };
            let r = Vec::new();
            r.push(v_bool(true));
            let i = 0;
            while i < (len(out) as i64) {
                r.push(out[i]);
                i = i + 1;
            }
            return r;
        };
        if id == B_PAIRS {
            let t = bs_arg(&args, 0);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument #1 to 'pairs' (table expected)"), 43);
                return Vec::new();
            };
            let r = Vec::new();
            r.push(v_builtin(B_NEXT));
            r.push(t);
            r.push(v_nil());
            return r;
        };
        if id == B_IPAIRS {
            let t = bs_arg(&args, 0);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument #1 to 'ipairs' (table expected)"), 44);
                return Vec::new();
            };
            let r = Vec::new();
            r.push(v_builtin(B_INEXT));
            r.push(t);
            r.push(v_int(0));
            return r;
        };
        if id == B_NEXT {
            let t = bs_arg(&args, 0);
            let k = bs_arg(&args, 1);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument to 'next'"), 22);
                return Vec::new();
            };
            if k.tag != VT_NIL {
                if !self.table_has(t.i, k) {
                    self.fail_str(STR_PTR("invalid key to 'next'"), 21);
                    return Vec::new();
                };
            };
            let (k2, v2) = self.table_next(t.i, k);
            let r = Vec::new();
            r.push(k2);
            r.push(v2);
            return r;
        };
        if id == B_INEXT {
            let t = bs_arg(&args, 0);
            let k = bs_arg(&args, 1);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument to 'ipairs'"), 24);
                return Vec::new();
            };
            let n = 0;
            if k.tag == VT_INT {
                n = k.i;
            };
            n = n + 1;
            let v = self.table_get(t.i, v_int(n));
            if v.tag == VT_NIL {
                return Vec::new();
            };
            let r = Vec::new();
            r.push(v_int(n));
            r.push(v);
            return r;
        };
        if id == B_SELECT {
            let k = bs_arg(&args, 0);
            if k.tag == VT_STR && s_eq_lit(k.s, STR_PTR("#"), 1) {
                return bs_one(v_int((len(args) as i64) - 1));
            };
            let n = 1;
            if k.tag == VT_INT {
                n = k.i;
            };
            if n < 0 {
                n = (len(args) as i64) + n;
            };
            if n < 1 {
                n = 1;
            };
            return bs_rest(&args, n);
        };
        if id == B_RAWGET {
            let t = bs_arg(&args, 0);
            return bs_one(self.table_get(t.i, bs_arg(&args, 1)));
        };
        if id == B_RAWSET {
            let t = bs_arg(&args, 0);
            self.table_set(t.i, bs_arg(&args, 1), bs_arg(&args, 2));
            return bs_one(t);
        };
        if id == B_RAWEQUAL {
            let a = bs_arg(&args, 0);
            let b = bs_arg(&args, 1);
            return bs_one(v_bool(v_equal(&a, &b)));
        };
        if id == B_GETMETA {
            let t = bs_arg(&args, 0);
            if t.tag == VT_TABLE {
                if self.tables[t.i].meta >= 0 {
                    return bs_one(v_table(self.tables[t.i].meta));
                };
            };
            if t.tag == VT_STR {
                let sm = self.table_get_str(self.globals, bs_str(STR_PTR("__strmeta"), 9));
                if sm.tag == VT_TABLE {
                    return bs_one(sm);
                };
            };
            return bs_one(v_nil());
        };
        if id == B_SETMETA {
            let t = bs_arg(&args, 0);
            let m = bs_arg(&args, 1);
            if t.tag == VT_TABLE {
                if m.tag == VT_TABLE {
                    self.tables[t.i].meta = m.i;
                } else {
                    self.tables[t.i].meta = -1;
                };
                self.set_weak_mode(t.i);
            };
            return bs_one(t);
        };
        if id >= B_S_LEN && id <= B_S_GSUB {
            return self.builtin_string(id, &args);
        };
        if id == B_OS_CLOCK || id == B_OS_TIME || (id >= B_OS_GETENV && id <= B_OS_EXIT) {
            return self.builtin_os(id, &args);
        };
        if id == B_IO_WRITE || (id >= B_IO_READ && id <= B_IO_POPEN) {
            return self.builtin_io(id, &args);
        };
        if (id >= B_T_INSERT && id <= B_T_SORT) || (id >= B_M_FLOOR && id <= B_M_RAD) || id == B_REQUIRE || id == B_PKG_SEARCHPATH || id == B_DBG_INFO || id == B_DBG_TRACE || id == B_CORO_RUNNING || id == B_CORO_UNSUPPORTED || id == B_IO_UNSUPPORTED {
            return self.builtin_aux(id, &args);
        };
        if id == B_GC {
            self.gc_collect();
            if len(args) > 0 {
                let a = args[0];
                if a.tag == VT_STR {
                    let opt = s_from(STR_PTR("count"), 5);
                    if s_eq(a.s, opt) {
                        return bs_one(v_num((self.mem_used as f64) / 1024.0));
                    };
                };
            };
            return bs_one(v_int(0));
        };
        if id == B_UTF8_CHAR {
            return self.utf8_char(&args);
        };
        if id == B_UTF8_LEN {
            return self.utf8_len(&args);
        };
        if id == B_UTF8_CODEPOINT {
            return self.utf8_codepoint(&args);
        };
        if id == B_UTF8_OFFSET {
            return self.utf8_offset(&args);
        };
        if id == B_UTF8_CODES {
            return self.utf8_codes(&args);
        };
        if id == B_UTF8_CODES_NEXT {
            return self.utf8_codes_next(&args);
        };
        if id == B_DBG_GETINFO {
            return self.dbg_getinfo(&args);
        };
        if id == B_DBG_GETUPVALUE {
            return self.dbg_getupvalue(&args);
        };
        if id == B_DBG_SETUPVALUE {
            return self.dbg_setupvalue(&args);
        };
        if id == B_DBG_GETLOCAL {
            return self.dbg_getlocal(&args);
        };
        if id == B_DBG_SETLOCAL {
            return self.dbg_setlocal(&args);
        };
        if id == B_DBG_TRACEBACK {
            return self.dbg_traceback(&args);
        };
        if id == B_DBG_SETHOOK {
            return self.dbg_sethook(&args);
        };
        if id == B_DBG_GETHOOK {
            return self.dbg_gethook(&args);
        };
        if id == B_DBG_GETREGISTRY {
            return self.dbg_getregistry(&args);
        };
        if id == B_DBG_GETMETATABLE {
            return self.dbg_getmetatable(&args);
        };
        if id == B_DBG_SETMETATABLE {
            return self.dbg_setmetatable(&args);
        };
        if id == B_SM_ADD || id == B_SM_SUB || id == B_SM_MUL || id == B_SM_MOD || id == B_SM_POW || id == B_SM_DIV || id == B_SM_IDIV {
            return self.sm_arith(id, &args);
        };
        if id == B_SM_UNM {
            return self.sm_unm(&args);
        };
        return Vec::new();
    };

    fn bi_load(&self, args: &Vec<Value>) -> Vec<Value> {
        let sv = bs_arg(args, 0);
        if sv.tag != VT_STR {
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(bs_str(STR_PTR("bad argument to 'load'"), 22)));
            return r;
        };
        let lx = lex_source(sv.s);
        let p = parse_tokens_base(lx, len(self.nodes) as i64, len(self.lists) as i64);
        if p.err != 0 {
            let msg = s_cat(bs_str(STR_PTR("syntax error near line "), 23), s_i64(p.errline));
            if p.errstr != 0 {
                msg = p.errstr;
            };
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(msg));
            return r;
        };
        let i = 0;
        while i < (len(p.nodes) as i64) {
            let nd = p.nodes[i];
            self.nodes.push(nd);
            i = i + 1;
        }
        let j = 0;
        while j < (len(p.lists) as i64) {
            let ls = p.lists[j];
            self.lists.push(ls);
            j = j + 1;
        }
        return bs_one(v_func(self.new_func(Vec::new(), p.root, 1, 0, -1)));
    }

    fn v_coerce_num(&self, v: Value) -> Value {
        if v.tag == VT_STR {
            return self.bi_tonumber(v);
        };
        return v;
    }

    fn sm_op_token(&self, id: i64) -> i64 {
        if id == B_SM_ADD {
            return TK_ADD;
        };
        if id == B_SM_SUB {
            return TK_SUB;
        };
        if id == B_SM_MUL {
            return TK_MUL;
        };
        if id == B_SM_MOD {
            return TK_MOD;
        };
        if id == B_SM_POW {
            return TK_POW;
        };
        if id == B_SM_DIV {
            return TK_DIV;
        };
        if id == B_SM_IDIV {
            return TK_IDIV;
        };
        return TK_SUB;
    }

    fn sm_op_name(&self, id: i64) -> u64 {
        if id == B_SM_ADD {
            return s_from(STR_PTR("add"), 3);
        };
        if id == B_SM_SUB {
            return s_from(STR_PTR("sub"), 3);
        };
        if id == B_SM_MUL {
            return s_from(STR_PTR("mul"), 3);
        };
        if id == B_SM_MOD {
            return s_from(STR_PTR("mod"), 3);
        };
        if id == B_SM_POW {
            return s_from(STR_PTR("pow"), 3);
        };
        if id == B_SM_DIV {
            return s_from(STR_PTR("div"), 3);
        };
        if id == B_SM_IDIV {
            return s_from(STR_PTR("idiv"), 4);
        };
        return s_from(STR_PTR("unm"), 3);
    }

    fn sm_arith(&self, id: i64, args: &Vec<Value>) -> Vec<Value> {
        let a0 = bs_arg(args, 0);
        let b0 = bs_arg(args, 1);
        let t1 = v_type_name(a0);
        let t2 = v_type_name(b0);
        let a = self.v_coerce_num(a0);
        let b = self.v_coerce_num(b0);
        if v_is_number(a) == false || v_is_number(b) == false {
            let m1 = s_cat(s_cat(s_from(STR_PTR("attempt to "), 11), self.sm_op_name(id)), s_from(STR_PTR(" a '"), 4));
            let m2 = s_cat(s_cat(m1, t1), s_from(STR_PTR("' with a '"), 10));
            let m3 = s_cat(m2, t2);
            self.fail_text(s_cat(m3, s_from(STR_PTR("'"), 1)));
            return Vec::new();
        };
        return bs_one(self.num_bin(self.sm_op_token(id), a, b));
    }

    fn sm_unm(&self, args: &Vec<Value>) -> Vec<Value> {
        let a0 = bs_arg(args, 0);
        let t1 = v_type_name(a0);
        let a = self.v_coerce_num(a0);
        if v_is_number(a) == false {
            let m1 = s_cat(s_cat(s_from(STR_PTR("attempt to "), 11), self.sm_op_name(B_SM_UNM)), s_from(STR_PTR(" a '"), 4));
            let m2 = s_cat(s_cat(m1, t1), s_from(STR_PTR("' with a '"), 10));
            let m3 = s_cat(m2, t1);
            self.fail_text(s_cat(m3, s_from(STR_PTR("'"), 1)));
            return Vec::new();
        };
        if a.tag == VT_INT {
            return bs_one(v_int(0 - a.i));
        };
        return bs_one(v_num(0.0 - a.f));
    }

    fn bi_tonumber(&self, v: Value) -> Value {
        if v_is_number(v) {
            return v;
        };
        if v.tag != VT_STR {
            return v_nil();
        };
        let raw = s_len(v.s);
        let a: u64 = 0;
        while a < raw && lx_is_space(s_byte(v.s, a)) {
            a = a + 1;
        }
        let b = raw;
        while b > a && lx_is_space(s_byte(v.s, b - 1)) {
            b = b - 1;
        }
        if a >= b {
            return v_nil();
        };
        let t = s_slice(v.s, a, b - a);
        let n = s_len(t);
        let i: u64 = 0;
        let neg = false;
        if s_byte(t, 0) == 45 {
            neg = true;
            i = 1;
        } else {
            if s_byte(t, 0) == 43 {
                i = 1;
            };
        };
        if i + 1 < n && s_byte(t, i) == 48 {
            let h = s_byte(t, i + 1);
            if h == 120 || h == 88 {
                return self.bi_tonumber_hex(t, i + 2, neg);
            };
        };
        let val: i64 = 0;
        let digits = 0;
        while i < n {
            let c = s_byte(t, i);
            if c < 48 || c > 57 {
                if s_num_valid(t) {
                    return v_num(SLA_PARSE_F64(t));
                };
                return v_nil();
            };
            val = val * 10 + (c as i64) - 48;
            digits = digits + 1;
            i = i + 1;
        }
        if digits == 0 {
            return v_nil();
        };
        if neg {
            return v_int(0 - val);
        };
        return v_int(val);
    };

    fn bi_tonumber_base(&self, v: Value, basev: Value) -> Value {
        let base = self.bi_int(basev, 10);
        if base < 2 || base > 36 {
            self.fail_str(STR_PTR("base out of range"), 17);
            return v_nil();
        };
        if v.tag != VT_STR {
            return v_nil();
        };
        let raw = s_len(v.s);
        let a: u64 = 0;
        while a < raw && lx_is_space(s_byte(v.s, a)) {
            a = a + 1;
        }
        let b = raw;
        while b > a && lx_is_space(s_byte(v.s, b - 1)) {
            b = b - 1;
        }
        if a >= b {
            return v_nil();
        };
        let i = a;
        let neg = false;
        if s_byte(v.s, i) == 45 {
            neg = true;
            i = i + 1;
        } else {
            if s_byte(v.s, i) == 43 {
                i = i + 1;
            };
        };
        if i >= b {
            return v_nil();
        };
        let val: i64 = 0;
        while i < b {
            let d = digit_val(s_byte(v.s, i));
            if d < 0 || d >= base {
                return v_nil();
            };
            val = val * base + d;
            i = i + 1;
        }
        if neg {
            return v_int(0 - val);
        };
        return v_int(val);
    };

    fn bi_tonumber_hex(&self, s: u64, from: u64, neg: bool) -> Value {
        let n = s_len(s);
        let i = from;
        let iv: i64 = 0;
        let fv = 0.0;
        let scale = 1.0;
        let isf = false;
        while i < n && lx_is_hex(s_byte(s, i)) {
            let d = lx_hex_val(s_byte(s, i));
            iv = iv * 16 + d;
            fv = fv * 16.0 + (d as f64);
            i = i + 1;
        }
        if i < n && s_byte(s, i) == 46 {
            isf = true;
            i = i + 1;
            while i < n && lx_is_hex(s_byte(s, i)) {
                scale = scale / 16.0;
                fv = fv + (lx_hex_val(s_byte(s, i)) as f64) * scale;
                i = i + 1;
            }
        };
        if i < n && (s_byte(s, i) == 112 || s_byte(s, i) == 80) {
            isf = true;
            i = i + 1;
            let eneg = false;
            if i < n && s_byte(s, i) == 45 {
                eneg = true;
                i = i + 1;
            } else {
                if i < n && s_byte(s, i) == 43 {
                    i = i + 1;
                };
            };
            let ex = 0;
            while i < n && lx_is_digit(s_byte(s, i)) {
                ex = ex * 10 + (s_byte(s, i) as i64) - 48;
                i = i + 1;
            }
            let k = 0;
            while k < ex {
                if eneg {
                    fv = fv / 2.0;
                } else {
                    fv = fv * 2.0;
                };
                k = k + 1;
            }
        };
        if i != n {
            return v_nil();
        };
        if isf {
            if neg {
                return v_num(0.0 - fv);
            };
            return v_num(fv);
        };
        if neg {
            return v_int(0 - iv);
        };
        return v_int(iv);
    }

};
