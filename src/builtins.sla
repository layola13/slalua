        self.table_set_str(co, bs_str(STR_PTR("create"), 6), v_builtin(B_CORO_UNSUPPORTED));
        self.table_set_str(co, bs_str(STR_PTR("resume"), 6), v_builtin(B_CORO_UNSUPPORTED));
        self.table_set_str(co, bs_str(STR_PTR("yield"), 5), v_builtin(B_CORO_UNSUPPORTED));
        self.table_set_str(co, bs_str(STR_PTR("wrap"), 4), v_builtin(B_CORO_UNSUPPORTED));
