    fn init_globals(&self) -> void {
        self.table_set_str(self.globals, bs_str(STR_PTR("print"), 5), v_builtin(B_PRINT));
        self.table_set_str(self.globals, bs_str(STR_PTR("type"), 4), v_builtin(B_TYPE));
        self.table_set_str(self.globals, bs_str(STR_PTR("tostring"), 8), v_builtin(B_TOSTRING));
        self.table_set_str(self.globals, bs_str(STR_PTR("tonumber"), 8), v_builtin(B_TONUMBER));
