impl Interp {
    fn init_globals(&self) -> void {
        self.table_set_str(self.globals, bs_str(STR_PTR("print"), 5), v_builtin(B_PRINT));
        self.table_set_str(self.globals, bs_str(STR_PTR("type"), 4), v_builtin(B_TYPE));
        self.table_set_str(self.globals, bs_str(STR_PTR("tostring"), 8), v_builtin(B_TOSTRING));
        self.table_set_str(self.globals, bs_str(STR_PTR("tonumber"), 8), v_builtin(B_TONUMBER));
        self.table_set_str(self.globals, bs_str(STR_PTR("assert"), 6), v_builtin(B_ASSERT));
        self.table_set_str(self.globals, bs_str(STR_PTR("error"), 5), v_builtin(B_ERROR));
        self.table_set_str(self.globals, bs_str(STR_PTR("pcall"), 5), v_builtin(B_PCALL));
        self.table_set_str(self.globals, bs_str(STR_PTR("xpcall"), 6), v_builtin(B_XPCALL));
        self.table_set_str(self.globals, bs_str(STR_PTR("load"), 4), v_builtin(B_LOAD));
        self.table_set_str(self.globals, bs_str(STR_PTR("pairs"), 5), v_builtin(B_PAIRS));
        self.table_set_str(self.globals, bs_str(STR_PTR("ipairs"), 6), v_builtin(B_IPAIRS));
        self.table_set_str(self.globals, bs_str(STR_PTR("next"), 4), v_builtin(B_NEXT));
        self.table_set_str(self.globals, bs_str(STR_PTR("select"), 6), v_builtin(B_SELECT));
        self.table_set_str(self.globals, bs_str(STR_PTR("rawget"), 6), v_builtin(B_RAWGET));
        self.table_set_str(self.globals, bs_str(STR_PTR("rawset"), 6), v_builtin(B_RAWSET));
        self.table_set_str(self.globals, bs_str(STR_PTR("rawequal"), 8), v_builtin(B_RAWEQUAL));
        self.table_set_str(self.globals, bs_str(STR_PTR("getmetatable"), 12), v_builtin(B_GETMETA));
        self.table_set_str(self.globals, bs_str(STR_PTR("setmetatable"), 12), v_builtin(B_SETMETA));
        self.table_set_str(self.globals, bs_str(STR_PTR("collectgarbage"), 14), v_builtin(B_GC));
        self.table_set_str(self.globals, bs_str(STR_PTR("require"), 7), v_builtin(B_REQUIRE));
        let dbg = self.new_table();
        self.table_set_str(dbg, bs_str(STR_PTR("getinfo"), 7), v_builtin(B_DBG_INFO));
        self.table_set_str(dbg, bs_str(STR_PTR("traceback"), 9), v_builtin(B_DBG_TRACE));
        self.table_set_str(self.globals, bs_str(STR_PTR("debug"), 5), v_table(dbg));
        let smeta = self.new_table();
        self.table_set_str(self.globals, bs_str(STR_PTR("__strmeta"), 9), v_table(smeta));
        let pkg = self.new_table();
        let loaded = self.new_table();
        let preload = self.new_table();
        self.table_set_str(pkg, bs_str(STR_PTR("loaded"), 6), v_table(loaded));
        self.table_set_str(pkg, bs_str(STR_PTR("preload"), 7), v_table(preload));
        self.table_set_str(pkg, bs_str(STR_PTR("path"), 4), v_str(bs_str(STR_PTR("../lua/testes/?.lua"), 21)));
        self.table_set_str(self.globals, bs_str(STR_PTR("package"), 7), v_table(pkg));
        self.table_set_str(self.globals, bs_str(STR_PTR("_G"), 2), v_table(self.globals));
        self.table_set_str(self.globals, bs_str(STR_PTR("_ENV"), 4), v_table(self.globals));
        self.table_set_str(self.globals, bs_str(STR_PTR("_VERSION"), 8), v_str(bs_str(STR_PTR("Lua 5.5"), 7)));
        let st = self.new_table();
        self.table_set_str(st, bs_str(STR_PTR("len"), 3), v_builtin(B_S_LEN));
        self.table_set_str(st, bs_str(STR_PTR("sub"), 3), v_builtin(B_S_SUB));
        self.table_set_str(st, bs_str(STR_PTR("upper"), 5), v_builtin(B_S_UPPER));
        self.table_set_str(st, bs_str(STR_PTR("lower"), 5), v_builtin(B_S_LOWER));
        self.table_set_str(st, bs_str(STR_PTR("byte"), 4), v_builtin(B_S_BYTE));
        self.table_set_str(st, bs_str(STR_PTR("char"), 4), v_builtin(B_S_CHAR));
        self.table_set_str(st, bs_str(STR_PTR("rep"), 3), v_builtin(B_S_REP));
        self.table_set_str(st, bs_str(STR_PTR("reverse"), 7), v_builtin(B_S_REVERSE));
        self.table_set_str(st, bs_str(STR_PTR("format"), 6), v_builtin(B_S_FORMAT));
        self.table_set_str(st, bs_str(STR_PTR("packsize"), 8), v_builtin(B_S_PACKSIZE));
        self.table_set_str(st, bs_str(STR_PTR("find"), 4), v_builtin(B_S_FIND));
        self.table_set_str(self.globals, bs_str(STR_PTR("string"), 6), v_table(st));
        let tt = self.new_table();
        self.table_set_str(tt, bs_str(STR_PTR("insert"), 6), v_builtin(B_T_INSERT));
        self.table_set_str(tt, bs_str(STR_PTR("remove"), 6), v_builtin(B_T_REMOVE));
        self.table_set_str(tt, bs_str(STR_PTR("concat"), 6), v_builtin(B_T_CONCAT));
        self.table_set_str(tt, bs_str(STR_PTR("pack"), 4), v_builtin(B_T_PACK));
        self.table_set_str(tt, bs_str(STR_PTR("unpack"), 6), v_builtin(B_T_UNPACK));
        self.table_set_str(tt, bs_str(STR_PTR("create"), 6), v_builtin(B_T_CREATE));
        self.table_set_str(self.globals, bs_str(STR_PTR("table"), 5), v_table(tt));
        let mt = self.new_table();
        self.table_set_str(mt, bs_str(STR_PTR("floor"), 5), v_builtin(B_M_FLOOR));
        self.table_set_str(mt, bs_str(STR_PTR("ceil"), 4), v_builtin(B_M_CEIL));
        self.table_set_str(mt, bs_str(STR_PTR("abs"), 3), v_builtin(B_M_ABS));
        self.table_set_str(mt, bs_str(STR_PTR("max"), 3), v_builtin(B_M_MAX));
        self.table_set_str(mt, bs_str(STR_PTR("min"), 3), v_builtin(B_M_MIN));
        self.table_set_str(mt, bs_str(STR_PTR("sqrt"), 4), v_builtin(B_M_SQRT));
        self.table_set_str(mt, bs_str(STR_PTR("type"), 4), v_builtin(B_M_TYPE));
        self.table_set_str(mt, bs_str(STR_PTR("tointeger"), 9), v_builtin(B_M_TOINT));
        self.table_set_str(mt, bs_str(STR_PTR("fmod"), 4), v_builtin(B_M_FMOD));
        self.table_set_str(mt, bs_str(STR_PTR("pi"), 2), v_num(3.141592653589793));
        self.table_set_str(mt, bs_str(STR_PTR("huge"), 4), v_num(sa_math_pow(2.0, 1024.0)));
        self.table_set_str(mt, bs_str(STR_PTR("maxinteger"), 10), v_int(9223372036854775807));
        self.table_set_str(mt, bs_str(STR_PTR("mininteger"), 10), v_int((0 - 9223372036854775807) - 1));
        self.table_set_str(self.globals, bs_str(STR_PTR("math"), 4), v_table(mt));
        let ot = self.new_table();
        self.table_set_str(ot, bs_str(STR_PTR("clock"), 5), v_builtin(B_OS_CLOCK));
        self.table_set_str(ot, bs_str(STR_PTR("time"), 4), v_builtin(B_OS_TIME));
        self.table_set_str(self.globals, bs_str(STR_PTR("os"), 2), v_table(ot));
    }

    fn builtin_call(&self, id: i64, args: Vec<Value>) -> Vec<Value> {
        if id == B_PRINT {
            let i = 0;
            while i < (len(args) as i64) {
                if i > 0 {
                    s_write(bs_str(STR_PTR(" "), 1));
                };
                s_write(v_to_string(args[i]));
                i = i + 1;
            }
            s_nl();
            return Vec::new();
        };
        if id == B_TYPE {
            return bs_one(v_str(v_type_name(bs_arg(&args, 0))));
        };
        if id == B_TOSTRING {
            return bs_one(v_str(v_to_string(bs_arg(&args, 0))));
        };
        if id == B_TONUMBER {
            return bs_one(self.bi_tonumber(bs_arg(&args, 0)));
        };
        if id == B_ASSERT {
            let a = bs_arg(&args, 0);
            if v_truthy(a) {
                return bs_copy(&args);
            };
            let m = v_str(bs_str(STR_PTR("assertion failed!"), 16));
            if len(args) > 1 {
                m = bs_arg(&args, 1);
            };
            self.err = v_to_string(m);
            self.ctrl = CTL_ERROR;
            return Vec::new();
        };
        if id == B_ERROR {
            let m = bs_arg(&args, 0);
            self.err = v_to_string(m);
            self.ctrl = CTL_ERROR;
            return Vec::new();
        };
        if id == B_LOAD {
            return self.bi_load(&args);
        };
        if id == B_XPCALL {
            let f = bs_arg(&args, 0);
            let h = bs_arg(&args, 1);
            let rest = bs_rest(&args, 2);
            self.err = 0;
            self.ctrl = CTL_NONE;
            let out = self.call_value(f, rest);
            if self.err != 0 {
                let msg = self.err;
                self.err = 0;
                self.ctrl = CTL_NONE;
                let hr = Vec::new();
                hr.push(v_str(msg));
                let ho = self.call_value(h, hr);
                let r = Vec::new();
                r.push(v_bool(false));
                if len(ho) > 0 {
                    r.push(ho[0]);
                } else {
                    r.push(v_str(msg));
                };
                return r;
            };
            let r = Vec::new();
            r.push(v_bool(true));
            let i = 0;
            while i < (len(out) as i64) {
                r.push(out[i]);
                i = i + 1;
            }
            return r;
        };
        if id == B_PCALL {
            let f = bs_arg(&args, 0);
            let rest = bs_rest(&args, 1);
            self.err = 0;
            self.ctrl = CTL_NONE;
            let out = self.call_value(f, rest);
            if self.err != 0 {
                let msg = self.err;
                self.err = 0;
                self.ctrl = CTL_NONE;
                let r = Vec::new();
                r.push(v_bool(false));
                r.push(v_str(msg));
                return r;
            };
            let r = Vec::new();
            r.push(v_bool(true));
            let i = 0;
            while i < (len(out) as i64) {
                r.push(out[i]);
                i = i + 1;
            }
            return r;
        };
        if id == B_PAIRS {
            let t = bs_arg(&args, 0);
            let r = Vec::new();
            r.push(v_builtin(B_NEXT));
            r.push(t);
            r.push(v_nil());
            return r;
        };
        if id == B_IPAIRS {
            let t = bs_arg(&args, 0);
            let r = Vec::new();
            r.push(v_builtin(B_INEXT));
            r.push(t);
            r.push(v_int(0));
            return r;
        };
        if id == B_NEXT {
            let t = bs_arg(&args, 0);
            let k = bs_arg(&args, 1);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument to 'next'"), 23);
                return Vec::new();
            };
            let (k2, v2) = self.table_next(t.i, k);
            let r = Vec::new();
            r.push(k2);
            r.push(v2);
            return r;
        };
        if id == B_INEXT {
            let t = bs_arg(&args, 0);
            let k = bs_arg(&args, 1);
            let n = 0;
            if k.tag == VT_INT {
                n = k.i;
            };
            n = n + 1;
            let v = self.table_get(t.i, v_int(n));
            if v.tag == VT_NIL {
                return Vec::new();
            };
            let r = Vec::new();
            r.push(v_int(n));
            r.push(v);
            return r;
        };
        if id == B_SELECT {
            let k = bs_arg(&args, 0);
            if k.tag == VT_STR && s_eq_lit(k.s, STR_PTR("#"), 1) {
                return bs_one(v_int((len(args) as i64) - 1));
            };
            let n = 1;
            if k.tag == VT_INT {
                n = k.i;
            };
            if n < 0 {
                n = (len(args) as i64) + n;
            };
            if n < 1 {
                n = 1;
            };
            return bs_rest(&args, n);
        };
        if id == B_RAWGET {
            let t = bs_arg(&args, 0);
            return bs_one(self.table_get(t.i, bs_arg(&args, 1)));
        };
        if id == B_RAWSET {
            let t = bs_arg(&args, 0);
            self.table_set(t.i, bs_arg(&args, 1), bs_arg(&args, 2));
            return bs_one(t);
        };
        if id == B_RAWEQUAL {
            let a = bs_arg(&args, 0);
            let b = bs_arg(&args, 1);
            return bs_one(v_bool(v_equal(&a, &b)));
        };
        if id == B_GETMETA {
            let t = bs_arg(&args, 0);
            if t.tag == VT_TABLE {
                if self.tables[t.i].meta >= 0 {
                    return bs_one(v_table(self.tables[t.i].meta));
                };
            };
            if t.tag == VT_STR {
                let sm = self.table_get_str(self.globals, bs_str(STR_PTR("__strmeta"), 9));
                if sm.tag == VT_TABLE {
                    return bs_one(sm);
                };
            };
            return bs_one(v_nil());
        };
        if id == B_SETMETA {
            let t = bs_arg(&args, 0);
            let m = bs_arg(&args, 1);
            if t.tag == VT_TABLE {
                if m.tag == VT_TABLE {
                    self.tables[t.i].meta = m.i;
                } else {
                    self.tables[t.i].meta = -1;
                };
            };
            return bs_one(t);
        };
        if id >= B_S_LEN && id <= B_S_FIND {
            return self.builtin_string(id, &args);
        };
        if (id >= B_T_INSERT && id <= B_T_CREATE) || (id >= B_M_FLOOR && id <= B_M_FMOD) || id == B_OS_CLOCK || id == B_OS_TIME || id == B_REQUIRE || id == B_DBG_INFO || id == B_DBG_TRACE {
            return self.builtin_aux(id, &args);
        };
        if id == B_GC {
            return bs_one(v_int(0));
        };
        return Vec::new();
    }

    fn bi_load(&self, args: &Vec<Value>) -> Vec<Value> {
        let sv = bs_arg(args, 0);
        if sv.tag != VT_STR {
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(bs_str(STR_PTR("bad argument to 'load'"), 23)));
            return r;
        };
        let lx = lex_source(sv.s);
        let p = parse_tokens_base(lx, len(self.nodes) as i64, len(self.lists) as i64);
        if p.err != 0 {
            let msg = s_cat(bs_str(STR_PTR("syntax error near line "), 25), s_i64(p.errline));
            if p.errstr != 0 {
                msg = p.errstr;
            };
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(msg));
            return r;
        };
        let i = 0;
        while i < (len(p.nodes) as i64) {
            let nd = p.nodes[i];
            self.nodes.push(nd);
            i = i + 1;
        }
        let j = 0;
        while j < (len(p.lists) as i64) {
            let ls = p.lists[j];
            self.lists.push(ls);
            j = j + 1;
        }
        return bs_one(v_func(self.new_func(Vec::new(), p.root, 1, 0, -1)));
    }

    fn bi_tonumber(&self, v: Value) -> Value {
        if v_is_number(v) {
            return v;
        };
        if v.tag != VT_STR {
            return v_nil();
        };
        let raw = s_len(v.s);
        let a: u64 = 0;
        while a < raw && lx_is_space(s_byte(v.s, a)) {
            a = a + 1;
        }
        let b = raw;
        while b > a && lx_is_space(s_byte(v.s, b - 1)) {
            b = b - 1;
        }
        if a >= b {
            return v_nil();
        };
        let t = s_slice(v.s, a, b - a);
        let n = s_len(t);
        let i: u64 = 0;
        let neg = false;
        if s_byte(t, 0) == 45 {
            neg = true;
            i = 1;
        } else {
            if s_byte(t, 0) == 43 {
                i = 1;
            };
        };
        if i + 1 < n && s_byte(t, i) == 48 {
            let h = s_byte(t, i + 1);
            if h == 120 || h == 88 {
                return self.bi_tonumber_hex(t, i + 2, neg);
            };
        };
        let val: i64 = 0;
        let digits = 0;
        while i < n {
            let c = s_byte(t, i);
            if c < 48 || c > 57 {
                return v_num(SLA_PARSE_F64(t));
            };
            val = val * 10 + (c as i64) - 48;
            digits = digits + 1;
            i = i + 1;
        }
        if digits == 0 {
            return v_nil();
        };
        if neg {
            return v_int(0 - val);
        };
        return v_int(val);
    }

    fn bi_tonumber_hex(&self, s: u64, from: u64, neg: bool) -> Value {
        let n = s_len(s);
        let i = from;
        let iv: i64 = 0;
        let fv = 0.0;
        let scale = 1.0;
        let isf = false;
        while i < n && lx_is_hex(s_byte(s, i)) {
            let d = lx_hex_val(s_byte(s, i));
            iv = iv * 16 + d;
            fv = fv * 16.0 + (d as f64);
            i = i + 1;
        }
        if i < n && s_byte(s, i) == 46 {
            isf = true;
            i = i + 1;
            while i < n && lx_is_hex(s_byte(s, i)) {
                scale = scale / 16.0;
                fv = fv + (lx_hex_val(s_byte(s, i)) as f64) * scale;
                i = i + 1;
            }
        };
        if i < n && (s_byte(s, i) == 112 || s_byte(s, i) == 80) {
            isf = true;
            i = i + 1;
            let eneg = false;
            if i < n && s_byte(s, i) == 45 {
                eneg = true;
                i = i + 1;
            } else {
                if i < n && s_byte(s, i) == 43 {
                    i = i + 1;
                };
            };
            let ex = 0;
            while i < n && lx_is_digit(s_byte(s, i)) {
                ex = ex * 10 + (s_byte(s, i) as i64) - 48;
                i = i + 1;
            }
            let k = 0;
            while k < ex {
                if eneg {
                    fv = fv / 2.0;
                } else {
                    fv = fv * 2.0;
                };
                k = k + 1;
            }
        };
        if i != n {
            return v_nil();
        };
        if isf {
            if neg {
                return v_num(0.0 - fv);
            };
            return v_num(fv);
        };
        if neg {
            return v_int(0 - iv);
        };
        return v_int(iv);
    }

}
