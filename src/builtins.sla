        self.table_set_str(co, bs_str(STR_PTR("close"), 5), v_builtin(B_CORO_UNSUPPORTED));
        self.table_set_str(co, bs_str(STR_PTR("run"), 3), v_builtin(B_CORO_UNSUPPORTED));
        self.table_set_str(self.globals, bs_str(STR_PTR("coroutine"), 9), v_table(co));
        let io = self.new_table();
