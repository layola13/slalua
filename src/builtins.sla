        self.table_set_str(st, bs_str(STR_PTR("sub"), 3), v_builtin(B_S_SUB));
        self.table_set_str(st, bs_str(STR_PTR("upper"), 5), v_builtin(B_S_UPPER));
        self.table_set_str(st, bs_str(STR_PTR("lower"), 5), v_builtin(B_S_LOWER));
        self.table_set_str(st, bs_str(STR_PTR("byte"), 4), v_builtin(B_S_BYTE));
        self.table_set_str(st, bs_str(STR_PTR("char"), 4), v_builtin(B_S_CHAR));
        self.table_set_str(st, bs_str(STR_PTR("rep"), 3), v_builtin(B_S_REP));
        self.table_set_str(st, bs_str(STR_PTR("reverse"), 7), v_builtin(B_S_REVERSE));
        self.table_set_str(st, bs_str(STR_PTR("format"), 6), v_builtin(B_S_FORMAT));
        self.table_set_str(st, bs_str(STR_PTR("packsize"), 8), v_builtin(B_S_PACKSIZE));
        self.table_set_str(st, bs_str(STR_PTR("pack"), 4), v_builtin(B_S_PACK));
        self.table_set_str(st, bs_str(STR_PTR("unpack"), 6), v_builtin(B_S_UNPACK));
        self.table_set_str(st, bs_str(STR_PTR("find"), 4), v_builtin(B_S_FIND));
        self.table_set_str(st, bs_str(STR_PTR("match"), 5), v_builtin(B_S_MATCH));
        self.table_set_str(st, bs_str(STR_PTR("gmatch"), 6), v_builtin(B_S_GMATCH));
        self.table_set_str(st, bs_str(STR_PTR("gsub"), 4), v_builtin(B_S_GSUB));
        self.table_set_str(self.globals, bs_str(STR_PTR("string"), 6), v_table(st));
        self.table_set_str(smeta, bs_str(STR_PTR("__index"), 7), v_table(st));
        let tt = self.new_table();
        self.table_set_str(tt, bs_str(STR_PTR("insert"), 6), v_builtin(B_T_INSERT));
        self.table_set_str(tt, bs_str(STR_PTR("remove"), 6), v_builtin(B_T_REMOVE));
        self.table_set_str(tt, bs_str(STR_PTR("concat"), 6), v_builtin(B_T_CONCAT));
        self.table_set_str(tt, bs_str(STR_PTR("pack"), 4), v_builtin(B_T_PACK));
        self.table_set_str(tt, bs_str(STR_PTR("unpack"), 6), v_builtin(B_T_UNPACK));
        self.table_set_str(tt, bs_str(STR_PTR("create"), 6), v_builtin(B_T_CREATE));
        self.table_set_str(tt, bs_str(STR_PTR("sort"), 4), v_builtin(B_T_SORT));
        self.table_set_str(tt, bs_str(STR_PTR("move"), 4), v_builtin(B_T_MOVE));
        self.table_set_str(self.globals, bs_str(STR_PTR("table"), 5), v_table(tt));
        let mt = self.new_table();
        self.table_set_str(mt, bs_str(STR_PTR("floor"), 5), v_builtin(B_M_FLOOR));
        self.table_set_str(mt, bs_str(STR_PTR("ceil"), 4), v_builtin(B_M_CEIL));
        self.table_set_str(mt, bs_str(STR_PTR("abs"), 3), v_builtin(B_M_ABS));
        self.table_set_str(mt, bs_str(STR_PTR("max"), 3), v_builtin(B_M_MAX));
        self.table_set_str(mt, bs_str(STR_PTR("min"), 3), v_builtin(B_M_MIN));
        self.table_set_str(mt, bs_str(STR_PTR("sqrt"), 4), v_builtin(B_M_SQRT));
        self.table_set_str(mt, bs_str(STR_PTR("type"), 4), v_builtin(B_M_TYPE));
        self.table_set_str(mt, bs_str(STR_PTR("tointeger"), 9), v_builtin(B_M_TOINT));
        self.table_set_str(mt, bs_str(STR_PTR("fmod"), 4), v_builtin(B_M_FMOD));
        self.table_set_str(mt, bs_str(STR_PTR("random"), 6), v_builtin(B_M_RANDOM));
        self.table_set_str(mt, bs_str(STR_PTR("randomseed"), 10), v_builtin(B_M_RANDOMSEED));
        self.table_set_str(mt, bs_str(STR_PTR("log"), 3), v_builtin(B_M_LOG));
        self.table_set_str(mt, bs_str(STR_PTR("exp"), 3), v_builtin(B_M_EXP));
        self.table_set_str(mt, bs_str(STR_PTR("sin"), 3), v_builtin(B_M_SIN));
        self.table_set_str(mt, bs_str(STR_PTR("cos"), 3), v_builtin(B_M_COS));
        self.table_set_str(mt, bs_str(STR_PTR("tan"), 3), v_builtin(B_M_TAN));
        self.table_set_str(mt, bs_str(STR_PTR("asin"), 4), v_builtin(B_M_ASIN));
        self.table_set_str(mt, bs_str(STR_PTR("acos"), 4), v_builtin(B_M_ACOS));
        self.table_set_str(mt, bs_str(STR_PTR("atan"), 4), v_builtin(B_M_ATAN));
        self.table_set_str(mt, bs_str(STR_PTR("modf"), 4), v_builtin(B_M_MODF));
        self.table_set_str(mt, bs_str(STR_PTR("deg"), 3), v_builtin(B_M_DEG));
        self.table_set_str(mt, bs_str(STR_PTR("rad"), 3), v_builtin(B_M_RAD));
        self.table_set_str(mt, bs_str(STR_PTR("pi"), 2), v_num(3.141592653589793));
        self.table_set_str(mt, bs_str(STR_PTR("huge"), 4), v_num(sa_math_pow(2.0, 1024.0)));
        self.table_set_str(mt, bs_str(STR_PTR("maxinteger"), 10), v_int(9223372036854775807));
        self.table_set_str(mt, bs_str(STR_PTR("mininteger"), 10), v_int((0 - 9223372036854775807) - 1));
        self.table_set_str(self.globals, bs_str(STR_PTR("math"), 4), v_table(mt));
        let ot = self.new_table();
        self.os_init_table(ot);
        self.table_set_str(self.globals, bs_str(STR_PTR("os"), 2), v_table(ot));
        self.table_set_str(loaded, bs_str(STR_PTR("_G"), 2), v_table(self.globals));
        self.table_set_str(loaded, bs_str(STR_PTR("package"), 7), v_table(pkg));
        self.table_set_str(loaded, bs_str(STR_PTR("string"), 6), v_table(st));
        self.table_set_str(loaded, bs_str(STR_PTR("table"), 5), v_table(tt));
        self.table_set_str(loaded, bs_str(STR_PTR("math"), 4), v_table(mt));
        self.table_set_str(loaded, bs_str(STR_PTR("os"), 2), v_table(ot));
        self.table_set_str(loaded, bs_str(STR_PTR("debug"), 5), v_table(dbg));
        self.table_set_str(loaded, bs_str(STR_PTR("coroutine"), 9), v_table(co));
        self.table_set_str(loaded, bs_str(STR_PTR("io"), 2), v_table(io));
        self.table_set_str(loaded, bs_str(STR_PTR("utf8"), 4), v_table(ut));
    }

    fn builtin_call(&self, id: i64, args: Vec<Value>) -> Vec<Value> {
        if id == B_PRINT {
            let i = 0;
            while i < (len(args) as i64) {
                if i > 0 {
                    s_write(bs_str(STR_PTR(" "), 1));
                };
                s_write(self.tostring_value(args[i]));
                i = i + 1;
            }
            s_nl();
            return Vec::new();
        };
        if id == B_TYPE {
            if len(args) < 1 {
                self.fail_str(STR_PTR("bad argument #1 to 'type' (value expected)"), 42);
                return Vec::new();
            };
            let tv = bs_arg(&args, 0);
            if self.io_is_file(tv) {
                return bs_one(v_str(s_from(STR_PTR("userdata"), 8)));
            };
            return bs_one(v_str(self.vtype_name(tv)));
        };
        if id == B_TOSTRING {
            if len(args) < 1 {
                self.fail_str(STR_PTR("bad argument #1 to 'tostring' (value expected)"), 46);
                return Vec::new();
            };
            let tv = bs_arg(&args, 0);
            if self.io_is_file(tv) {
                return bs_one(v_str(self.io_file_string(tv.i)));
            };
            return bs_one(v_str(self.tostring_value(tv)));
        };
        if id == B_TONUMBER {
            if len(args) < 1 {
                self.fail_str(STR_PTR("bad argument #1 to 'tonumber' (value expected)"), 46);
                return Vec::new();
            };
            if len(args) > 1 {
                return bs_one(self.bi_tonumber_base(bs_arg(&args, 0), bs_arg(&args, 1)));
            };
            return bs_one(self.bi_tonumber(bs_arg(&args, 0)));
        };
        if id == B_ASSERT {
            let a = bs_arg(&args, 0);
            if v_truthy(a) {
                return bs_copy(&args);
            };
            let m = v_str(bs_str(STR_PTR("assertion failed!"), 17));
            if len(args) > 1 {
                m = bs_arg(&args, 1);
            };
            if self.err == 0 {
                self.err = v_to_string(m);
            };
            self.ctrl = CTL_ERROR;
            return Vec::new();
        };
        if id == B_ERROR {
            let m = bs_arg(&args, 0);
            if m.tag == VT_NIL {
                self.err = bs_str(STR_PTR("<no error object>"), 17);
            } else {
                self.err = v_to_string(m);
            };
            self.ctrl = CTL_ERROR;
            return Vec::new();
        };
        if id == B_LOAD {
            return self.bi_load(&args);
        };
        if id == B_LOADFILE {
            return self.bi_loadfile(&args);
        };
        if id == B_DOFILE {
            return self.bi_dofile(&args);
        };
        if id == B_XPCALL {
            let f = bs_arg(&args, 0);
            let h = bs_arg(&args, 1);
            let rest = bs_rest(&args, 2);
            self.err = 0;
            self.ctrl = CTL_NONE;
            let out = self.call_value(f, rest);
            if self.err != 0 {
                let msg = self.err;
                self.err = 0;
                self.ctrl = CTL_NONE;
                let hr = Vec::new();
                hr.push(v_str(msg));
                self.in_error = self.in_error + 1;
                let ho = self.call_value(h, hr);
                self.in_error = self.in_error - 1;
                let r = Vec::new();
                r.push(v_bool(false));
                if self.err != 0 {
                    let hm = self.err;
                    self.err = 0;
                    self.ctrl = CTL_NONE;
                    r.push(v_str(hm));
                } else {
                    if len(ho) > 0 {
                        r.push(ho[0]);
                    } else {
                        r.push(v_str(msg));
                    };
                };
                return r;
            };
            let r = Vec::new();
            r.push(v_bool(true));
            let i = 0;
            while i < (len(out) as i64) {
                r.push(out[i]);
                i = i + 1;
            }
            return r;
        };
        if id == B_PCALL {
            let f = bs_arg(&args, 0);
            let rest = bs_rest(&args, 1);
            self.err = 0;
            self.ctrl = CTL_NONE;
            let out = self.call_value(f, rest);
            if self.err != 0 {
                let msg = self.err;
                self.err = 0;
                self.ctrl = CTL_NONE;
                let r = Vec::new();
                r.push(v_bool(false));
                r.push(v_str(msg));
                return r;
            };
            let r = Vec::new();
            r.push(v_bool(true));
            let i = 0;
            while i < (len(out) as i64) {
                r.push(out[i]);
                i = i + 1;
            }
            return r;
        };
        if id == B_PAIRS {
            let t = bs_arg(&args, 0);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument #1 to 'pairs' (table expected)"), 43);
                return Vec::new();
            };
            let r = Vec::new();
            r.push(v_builtin(B_NEXT));
            r.push(t);
            r.push(v_nil());
            return r;
        };
        if id == B_IPAIRS {
            let t = bs_arg(&args, 0);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument #1 to 'ipairs' (table expected)"), 44);
                return Vec::new();
            };
            let r = Vec::new();
            r.push(v_builtin(B_INEXT));
            r.push(t);
            r.push(v_int(0));
            return r;
        };
        if id == B_NEXT {
            let t = bs_arg(&args, 0);
            let k = bs_arg(&args, 1);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument to 'next'"), 22);
                return Vec::new();
            };
            if k.tag != VT_NIL {
                if !self.table_has(t.i, k) {
                    self.fail_str(STR_PTR("invalid key to 'next'"), 21);
                    return Vec::new();
                };
            };
            let (k2, v2) = self.table_next(t.i, k);
            let r = Vec::new();
            r.push(k2);
            r.push(v2);
            return r;
        };
        if id == B_INEXT {
            let t = bs_arg(&args, 0);
            let k = bs_arg(&args, 1);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument to 'ipairs'"), 24);
                return Vec::new();
            };
            let n = 0;
            if k.tag == VT_INT {
                n = k.i;
            };
            n = n + 1;
            let v = self.table_get(t.i, v_int(n));
            if v.tag == VT_NIL {
                return Vec::new();
            };
            let r = Vec::new();
            r.push(v_int(n));
            r.push(v);
            return r;
        };
        if id == B_SELECT {
            let k = bs_arg(&args, 0);
            if k.tag == VT_STR && s_eq_lit(k.s, STR_PTR("#"), 1) {
                return bs_one(v_int((len(args) as i64) - 1));
            };
            let n = 1;
            if k.tag == VT_INT {
                n = k.i;
            };
            if n < 0 {
                n = (len(args) as i64) + n;
            };
            if n < 1 {
                n = 1;
            };
            return bs_rest(&args, n);
        };
        if id == B_RAWGET {
            let t = bs_arg(&args, 0);
            return bs_one(self.table_get(t.i, bs_arg(&args, 1)));
        };
        if id == B_RAWSET {
            let t = bs_arg(&args, 0);
            self.table_set(t.i, bs_arg(&args, 1), bs_arg(&args, 2));
            return bs_one(t);
        };
        if id == B_RAWEQUAL {
            let a = bs_arg(&args, 0);
            let b = bs_arg(&args, 1);
            return bs_one(v_bool(v_equal(&a, &b)));
        };
        if id == B_RAWLEN {
            if len(args) < 1 {
                self.fail_str(STR_PTR("bad argument #1 to 'rawlen' (value expected)"), 44);
                return Vec::new();
            };
            let v = bs_arg(&args, 0);
            if self.io_is_file(v) {
                self.fail_str(STR_PTR("bad argument #1 to 'rawlen' (table or string expected)"), 54);
                return Vec::new();
            };
            if v.tag == VT_STR {
                return bs_one(v_int(s_len(v.s) as i64));
            };
            if v.tag == VT_TABLE {
                return bs_one(v_int(self.table_len(v.i)));
            };
            self.fail_str(STR_PTR("bad argument #1 to 'rawlen' (table or string expected)"), 54);
            return Vec::new();
        };
        if id == B_GETMETA {
            let t = bs_arg(&args, 0);
            if t.tag == VT_TABLE {
                if self.tables[t.i].meta >= 0 {
                    let m = self.tables[t.i].meta;
                    let prot = self.table_get_str(m, bs_str(STR_PTR("__metatable"), 11));
                    if prot.tag != VT_NIL {
                        return bs_one(prot);
                    };
                    return bs_one(v_table(m));
                };
            };
            if t.tag == VT_STR {
                let sm = self.table_get_str(self.globals, bs_str(STR_PTR("__strmeta"), 9));
                if sm.tag == VT_TABLE {
                    return bs_one(sm);
                };
            };
            let tm = self.type_meta(self.vtype_name(t));
            if tm >= 0 {
                return bs_one(v_table(tm));
            };
            return bs_one(v_nil());
        };
        if id == B_SETMETA {
            let t = bs_arg(&args, 0);
            let m = bs_arg(&args, 1);
            if t.tag != VT_TABLE {
                self.fail_str(STR_PTR("bad argument #1 to 'setmetatable' (table expected)"), 50);
                return Vec::new();
            };
            if m.tag != VT_TABLE && m.tag != VT_NIL {
                self.fail_str(STR_PTR("bad argument #2 to 'setmetatable' (nil or table expected)"), 57);
                return Vec::new();
            };
            if self.tables[t.i].meta >= 0 {
                let cur = self.tables[t.i].meta;
                let prot = self.table_get_str(cur, bs_str(STR_PTR("__metatable"), 11));
                if prot.tag != VT_NIL {
                    self.fail_str(STR_PTR("cannot change a protected metatable"), 35);
                    return Vec::new();
                };
            };
            if m.tag == VT_TABLE {
                self.tables[t.i].meta = m.i;
            } else {
                self.tables[t.i].meta = -1;
            };
            self.set_weak_mode(t.i);
            return bs_one(t);
        };
        if (id >= B_S_LEN && id <= B_S_GSUB) || id == B_S_PACK || id == B_S_UNPACK {
            return self.builtin_string(id, &args);
        };
        if id == B_OS_CLOCK || id == B_OS_TIME || (id >= B_OS_GETENV && id <= B_OS_EXIT) {
            return self.builtin_os(id, &args);
        };
        if id == B_IO_WRITE || (id >= B_IO_READ && id <= B_IO_POPEN) {
            return self.builtin_io(id, &args);
        };
        if id == B_T_MOVE {
            return self.bi_table_move(&args);
        };
        if (id >= B_T_INSERT && id <= B_T_SORT) || (id >= B_M_FLOOR && id <= B_M_RAD) || id == B_REQUIRE || id == B_PKG_SEARCHPATH || id == B_DBG_INFO || id == B_DBG_TRACE || id == B_CORO_RUNNING || id == B_CORO_UNSUPPORTED || id == B_IO_UNSUPPORTED {
            return self.builtin_aux(id, &args);
        };
        if id == B_GC {
            self.gc_collect();
            if len(args) > 0 {
                let a = args[0];
                if a.tag == VT_STR {
                    let opt = s_from(STR_PTR("count"), 5);
                    if s_eq(a.s, opt) {
                        return bs_one(v_num((self.mem_used as f64) / 1024.0));
                    };
                };
            };
            return bs_one(v_int(0));
        };
        if id == B_UTF8_CHAR {
            return self.utf8_char(&args);
        };
        if id == B_UTF8_LEN {
            return self.utf8_len(&args);
        };
        if id == B_UTF8_CODEPOINT {
            return self.utf8_codepoint(&args);
        };
        if id == B_UTF8_OFFSET {
            return self.utf8_offset(&args);
        };
        if id == B_UTF8_CODES {
            return self.utf8_codes(&args);
        };
        if id == B_UTF8_CODES_NEXT {
            return self.utf8_codes_next(&args);
        };
        if id == B_UTF8_CODES_NEXT_LAX {
            return self.utf8_codes_next_lax(&args);
        };
        if id == B_DBG_GETINFO {
            return self.dbg_getinfo(&args);
        };
        if id == B_DBG_GETUPVALUE {
            return self.dbg_getupvalue(&args);
        };
        if id == B_DBG_SETUPVALUE {
            return self.dbg_setupvalue(&args);
        };
        if id == B_DBG_GETLOCAL {
            return self.dbg_getlocal(&args);
        };
        if id == B_DBG_SETLOCAL {
            return self.dbg_setlocal(&args);
        };
        if id == B_DBG_TRACEBACK {
            return self.dbg_traceback(&args);
        };
        if id == B_DBG_SETHOOK {
            return self.dbg_sethook(&args);
        };
        if id == B_DBG_GETHOOK {
            return self.dbg_gethook(&args);
        };
        if id == B_DBG_GETREGISTRY {
            return self.dbg_getregistry(&args);
        };
        if id == B_DBG_GETMETATABLE {
            return self.dbg_getmetatable(&args);
        };
        if id == B_DBG_SETMETATABLE {
            return self.dbg_setmetatable(&args);
        };
        if id == B_SM_ADD || id == B_SM_SUB || id == B_SM_MUL || id == B_SM_MOD || id == B_SM_POW || id == B_SM_DIV || id == B_SM_IDIV {
            return self.sm_arith(id, &args);
        };
        if id == B_SM_UNM {
            return self.sm_unm(&args);
        };
        return Vec::new();
    };

    fn bi_load(&self, args: &Vec<Value>) -> Vec<Value> {
        let sv = bs_arg(args, 0);
        if len(args) > 2 {
            let mv = bs_arg(args, 2);
            if mv.tag == VT_STR {
                let mode = mv.s;
                let ok = s_eq_lit(mode, STR_PTR("t"), 1) || s_eq_lit(mode, STR_PTR("b"), 1) || s_eq_lit(mode, STR_PTR("bt"), 2);
                if ok == false {
                    self.fail_str(STR_PTR("invalid mode"), 12);
                    return Vec::new();
                };
            };
        };
        if sv.tag == VT_FUNC || sv.tag == VT_BUILTIN {
            let mut_src = bs_str(STR_PTR(""), 0);
            let mut_done = false;
            while mut_done == false {
                let r = self.call_value(sv, Vec::new());
                if len(r) == 0 {
                    mut_done = true;
                    continue;
                };
                if r[0].tag == VT_NIL {
                    mut_done = true;
                    continue;
                };
                if r[0].tag != VT_STR {
                    self.fail_str(STR_PTR("reader function must return a string"), 36);
                    return Vec::new();
                };
                if s_len(r[0].s) == 0 {
                    mut_done = true;
                    continue;
                };
                mut_src = s_cat(mut_src, r[0].s);
            }
            return self.bi_load_source(mut_src);
        };
        if sv.tag != VT_STR {
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(bs_str(STR_PTR("bad argument to 'load'"), 22)));
            return r;
        };
        return self.bi_load_source(sv.s);
    }

    fn bi_load_source(&self, src: u64) -> Vec<Value> {
        let lx = lex_source(src);
        let p = parse_tokens_base(lx, len(self.nodes) as i64, len(self.lists) as i64);
        if p.err != 0 {
            let msg = s_cat(bs_str(STR_PTR("syntax error near line "), 23), s_i64(p.errline));
            if p.errstr != 0 {
                msg = p.errstr;
            };
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(msg));
            return r;
        };
        let i = 0;
        while i < (len(p.nodes) as i64) {
            let nd = p.nodes[i];
            self.nodes.push(nd);
            i = i + 1;
        }
        let j = 0;
        while j < (len(p.lists) as i64) {
            let ls = p.lists[j];
            self.lists.push(ls);
            j = j + 1;
        }
        return bs_one(v_func(self.new_func(Vec::new(), p.root, 1, 0, -1)));
    }

    fn bi_loadfile(&self, args: &Vec<Value>) -> Vec<Value> {
        let pv = bs_arg(args, 0);
        if pv.tag != VT_STR {
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(bs_str(STR_PTR("bad argument to 'loadfile'"), 26)));
            return r;
        };
        let (ok, src) = self.io_read_disk(pv.s);
        if ok == false {
            let r = Vec::new();
            r.push(v_nil());
            r.push(v_str(s_cat(bs_str(STR_PTR("cannot open "), 12), pv.s)));
            return r;
        };
        return self.bi_load_source(src);
    }

    fn bi_dofile(&self, args: &Vec<Value>) -> Vec<Value> {
        let pv = bs_arg(args, 0);
        if pv.tag != VT_STR {
            self.fail_str(STR_PTR("bad argument to 'dofile'"), 24);
            return Vec::new();
        };
        let (ok, src) = self.io_read_disk(pv.s);
        if ok == false {
            self.fail_text(s_cat(bs_str(STR_PTR("cannot open "), 12), pv.s));
            return Vec::new();
        };
        let fv = self.bi_load_source(src);
        if fv[0].tag != VT_FUNC {
            self.fail_text(v_to_string(fv[1]));
            return Vec::new();
        };
        return self.call_value(fv[0], Vec::new());
    }

    fn sm_op_token(&self, id: i64) -> i64 {
        if id == B_SM_ADD {
            return TK_ADD;
        };
        if id == B_SM_SUB {
            return TK_SUB;
        };
        if id == B_SM_MUL {
            return TK_MUL;
        };
        if id == B_SM_MOD {
            return TK_MOD;
        };
        if id == B_SM_POW {
            return TK_POW;
        };
        if id == B_SM_DIV {
            return TK_DIV;
        };
        if id == B_SM_IDIV {
            return TK_IDIV;
        };
        return TK_SUB;
    }

    fn sm_op_name(&self, id: i64) -> u64 {
        if id == B_SM_ADD {
            return s_from(STR_PTR("add"), 3);
        };
        if id == B_SM_SUB {
            return s_from(STR_PTR("sub"), 3);
        };
        if id == B_SM_MUL {
            return s_from(STR_PTR("mul"), 3);
        };
        if id == B_SM_MOD {
            return s_from(STR_PTR("mod"), 3);
        };
        if id == B_SM_POW {
            return s_from(STR_PTR("pow"), 3);
        };
        if id == B_SM_DIV {
            return s_from(STR_PTR("div"), 3);
        };
        if id == B_SM_IDIV {
            return s_from(STR_PTR("idiv"), 4);
        };
        return s_from(STR_PTR("unm"), 3);
    }

    fn sm_arith(&self, id: i64, args: &Vec<Value>) -> Vec<Value> {
        let a0 = bs_arg(args, 0);
        let b0 = bs_arg(args, 1);
        let t1 = self.vtype_name(a0);
        let t2 = self.vtype_name(b0);
        let a = self.v_coerce_num(a0);
        let b = self.v_coerce_num(b0);
        if v_is_number(a) == false || v_is_number(b) == false {
            let m1 = s_cat(s_cat(s_from(STR_PTR("attempt to "), 11), self.sm_op_name(id)), s_from(STR_PTR(" a '"), 4));
            let m2 = s_cat(s_cat(m1, t1), s_from(STR_PTR("' with a '"), 10));
            let m3 = s_cat(m2, t2);
            self.fail_text(s_cat(m3, s_from(STR_PTR("'"), 1)));
            return Vec::new();
        };
        return bs_one(self.num_bin(self.sm_op_token(id), a, b));
    }

    fn sm_unm(&self, args: &Vec<Value>) -> Vec<Value> {
        let a0 = bs_arg(args, 0);
        let t1 = self.vtype_name(a0);
        let a = self.v_coerce_num(a0);
        if v_is_number(a) == false {
            let m1 = s_cat(s_cat(s_from(STR_PTR("attempt to "), 11), self.sm_op_name(B_SM_UNM)), s_from(STR_PTR(" a '"), 4));
            let m2 = s_cat(s_cat(m1, t1), s_from(STR_PTR("' with a '"), 10));
            let m3 = s_cat(m2, t1);
            self.fail_text(s_cat(m3, s_from(STR_PTR("'"), 1)));
            return Vec::new();
        };
        if a.tag == VT_INT {
            return bs_one(v_int(0 - a.i));
        };
        return bs_one(v_num(0.0 - a.f));
    }

};