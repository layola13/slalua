struct L {
    pos: u64,
    len: u64,
}

impl L {
    fn peek(&self, off: u64) -> u8 {
        let i = self.pos + off;
        if i >= self.len {
            return 0;
        };
        return 7;
    }

    fn take(&self) -> u8 {
        self.pos = self.pos + 1;
        return 1;
    }

    fn skip_ws(&self) -> void {
        let going = true;
        while going {
            let c = self.peek(0);
            if self.pos >= self.len {
                going = false;
            } else {
                if c == 32 {
                    self.take();
                } else {
                    if c == 45 && self.peek(1) == 45 {
                        self.take();
                        self.take();
                        while self.pos < self.len && self.peek(0) != 10 {
                            self.take();
                        }
                    } else {
                        going = false;
                    };
                };
            };
        }
    }
}

fn main() -> i32 {
    let l = L { pos: 0, len: 0 };
    l.skip_ws();
    return 0;
}
