@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "src/ast.sla"
@import "src/value.sla"
@import "src/strutil.sla"

const CTL_NONE: i64 = 0;
const CTL_RETURN: i64 = 1;
const CTL_BREAK: i64 = 2;
const CTL_GOTO: i64 = 3;
const CTL_ERROR: i64 = 4;

struct Binding {
    name: u64,
    val: Value,
    cons: i64,
}

struct Env {
    parent: i64,
    vars: Vec<Binding>,
    varargs: Vec<Value>,
    vargname: u64,
}

struct Entry {
    key: Value,
    val: Value,
}

struct Table {
    entries: Vec<Entry>,
    hashes: Vec<u64>,
    buckets: Vec<i64>,
    dead: i64,
    meta: i64,
}

struct Func {
    params: Vec<i64>,
    body: i64,
    vararg: i64,
    has_self: i64,
    env: i64,
}

struct Interp {
    nodes: Vec<Node>,
    lists: Vec<List>,
    envs: Vec<Env>,
    tables: Vec<Table>,
    funcs: Vec<Func>,
    globals: i64,
    err: u64,
    ctrl: i64,
    retvals: Vec<Value>,
    gotolabel: u64,
    curline: i64,
    rng0: u64,
    rng1: u64,
}

fn binding_new(name: u64, val: Value, cons: i64) -> Binding {
    return Binding { name: name, val: val, cons: cons };
}

fn env_new(parent: i64) -> Env {
    return Env { parent: parent, vars: Vec::new(), varargs: Vec::new(), vargname: 0 };
}

fn entry_new(key: Value, val: Value) -> Entry {
    return Entry { key: key, val: val };
}

fn table_new() -> Table {
    return Table {
        entries: Vec::new(),
        hashes: Vec::new(),
        buckets: Vec::new(),
        dead: 0,
        meta: -1,
    };
}

fn func_new(params: Vec<i64>, body: i64, vararg: i64, has_self: i64, env: i64) -> Func {
    return Func { params: params, body: body, vararg: vararg, has_self: has_self, env: env };
}

fn interp_new(nodes: Vec<Node>, lists: Vec<List>) -> Interp {
    let it = Interp {
        nodes: nodes,
        lists: lists,
        envs: Vec::new(),
        tables: Vec::new(),
        funcs: Vec::new(),
        globals: 0,
        err: 0,
        ctrl: 0,
        retvals: Vec::new(),
        gotolabel: 0,
        curline: 0,
        rng0: 88172645463325252,
        rng1: 6364136223846793005,
    };
    it.globals = it.new_table();
    return it;
}

impl Interp {
    fn nd(&self, id: i64) -> Node {
        return self.nodes[id];
    }

    fn list_get(&self, lid: i64, i: i64) -> i64 {
        return self.lists[lid].items[i];
    }

    fn list_len(&self, lid: i64) -> i64 {
        return len(self.lists[lid].items) as i64;
    }

    fn new_env(&self, parent: i64) -> i64 {
        let id = len(self.envs) as i64;
        self.envs.push(env_new(parent));
        if parent >= 0 {
            self.envs[id].vargname = self.envs[parent].vargname;
            let i = 0;
            while i < (len(self.envs[parent].varargs) as i64) {
                let v = self.envs[parent].varargs[i];
                self.envs[id].varargs.push(v);
                i = i + 1;
            }
        };
        return id;
    }

    fn new_table(&self) -> i64 {
        let id = len(self.tables) as i64;
        self.tables.push(table_new());
        return id;
    }

    fn new_func(&self, params: Vec<i64>, body: i64, vararg: i64, has_self: i64, env: i64) -> i64 {
        let id = len(self.funcs) as i64;
        self.funcs.push(func_new(params, body, vararg, has_self, env));
        return id;
    }

    fn env_define(&self, env: i64, name: u64, val: Value, cons: i64) -> void {
        self.envs[env].vars.push(binding_new(name, val, cons));
    }

    fn env_find_env(&self, env: i64, name: u64) -> i64 {
        let cur = env;
        while cur >= 0 {
            let vars = self.envs[cur].vars;
            let i = (len(vars) as i64) - 1;
            while i >= 0 {
                if s_eq(vars[i].name, name) {
                    return cur;
                };
                i = i - 1;
            }
            cur = self.envs[cur].parent;
        }
        return -1;
    }

    fn env_update(&self, env: i64, name: u64, val: Value) -> bool {
        let vars = self.envs[env].vars;
        let i = (len(vars) as i64) - 1;
        while i >= 0 {
            if s_eq(vars[i].name, name) {
                if vars[i].cons != 0 {
                    self.fail_str(STR_PTR("attempt to assign to const variable"), 38);
                    return false;
                };
                let nv = value_new(val.tag, val.i, val.f, val.s);
                self.envs[env].vars[i].val = nv;
                return true;
            };
            i = i - 1;
        }
        return false;
    }

    fn env_vargname(&self, env: i64) -> u64 {
        let cur = env;
        while cur >= 0 {
            if self.envs[cur].vargname != 0 {
                return self.envs[cur].vargname;
            };
            cur = self.envs[cur].parent;
        }
        return 0;
    }

    fn env_get(&self, env: i64, name: u64) -> Value {
        let found = self.env_find_env(env, name);
        if found >= 0 {
            let vars = self.envs[found].vars;
            let i = (len(vars) as i64) - 1;
            while i >= 0 {
                if s_eq(vars[i].name, name) {
                    return vars[i].val;
                };
                i = i - 1;
            }
        };
        return self.table_get(self.globals, v_str(name));
    }

    fn env_set(&self, env: i64, name: u64, val: Value) -> void {
        let found = self.env_find_env(env, name);
        if found >= 0 {
            self.env_update(found, name, val);
            return;
        };
        self.table_set(self.globals, v_str(name), val);
    }

    fn t_find(&self, tid: i64, key: &Value, h: u64) -> i64 {
        let cap = len(self.tables[tid].buckets) as i64;
        if cap == 0 {
            return -1;
        };
        let mask = cap - 1;
        let s = (h & (mask as u64)) as i64;
        let step = 0;
        while step <= mask {
            let b = self.tables[tid].buckets[s];
            if b < 0 {
                return -1;
            };
            if self.tables[tid].hashes[b] == h {
                if v_equal(&self.tables[tid].entries[b].key, key) {
                    return b;
                };
            };
            s = (s + 1) & mask;
            step = step + 1;
        }
        return -1;
    }

    fn t_rebuild(&self, tid: i64, want: i64) -> void {
        let n = len(self.tables[tid].entries) as i64;
        let need = n * 2 + 8;
        let cap: i64 = 8;
        while cap < need {
            cap = cap * 2;
        }
        if want > cap {
            cap = want;
        };
        let buckets = Vec::new();
        let k = 0;
        while k < cap {
            buckets.push(-1);
            k = k + 1;
        }
        let mask = cap - 1;
        let i = 0;
        while i < n {
            let h = self.tables[tid].hashes[i];
            let s = (h & (mask as u64)) as i64;
            let step = 0;
            while buckets[s] >= 0 {
                s = (s + 1) & mask;
                step = step + 1;
            }
            buckets[s] = i;
            i = i + 1;
        }
        self.tables[tid].buckets = buckets;
    }

    fn t_grow(&self, tid: i64) -> void {
        let cap = len(self.tables[tid].buckets) as i64;
        if cap == 0 {
            self.t_rebuild(tid, 8);
            return;
        };
        let n = len(self.tables[tid].entries) as i64;
        if (n + 1) * 10 > cap * 7 {
            self.t_rebuild(tid, cap * 2);
        };
    }

    fn t_compact(&self, tid: i64) -> void {
        let entries = Vec::new();
        let hashes = Vec::new();
        let i = 0;
        while i < (len(self.tables[tid].entries) as i64) {
            if self.tables[tid].entries[i].val.tag != VT_NIL {
                entries.push(self.tables[tid].entries[i]);
                hashes.push(self.tables[tid].hashes[i]);
            };
            i = i + 1;
        }
        self.tables[tid].entries = entries;
        self.tables[tid].hashes = hashes;
        self.tables[tid].dead = 0;
        self.t_rebuild(tid, 0);
    }

    fn t_insert(&self, tid: i64, key: Value, val: Value, h: u64) -> void {
        let live = (len(self.tables[tid].entries) as i64) - self.tables[tid].dead;
        if self.tables[tid].dead > 64 {
            if self.tables[tid].dead > live {
                self.t_compact(tid);
            };
        };
        self.t_grow(tid);
        let cap = len(self.tables[tid].buckets) as i64;
        let mask = cap - 1;
        let s = (h & (mask as u64)) as i64;
        let step = 0;
        while self.tables[tid].buckets[s] >= 0 {
            s = (s + 1) & mask;
            step = step + 1;
        }
        let idx = len(self.tables[tid].entries) as i64;
        self.tables[tid].entries.push(entry_new(key, val));
        self.tables[tid].hashes.push(h);
        self.tables[tid].buckets[s] = idx;
    }

    fn t_next_from(&self, tid: i64, start: i64) -> (Value, Value) {
        let j = start;
        while j < (len(self.tables[tid].entries) as i64) {
            if self.tables[tid].entries[j].val.tag != VT_NIL {
                return (self.tables[tid].entries[j].key, self.tables[tid].entries[j].val);
            };
            j = j + 1;
        }
        return (v_nil(), v_nil());
    }

    fn table_get(&self, tid: i64, key: Value) -> Value {
        let h = v_hash(&key);
        let idx = self.t_find(tid, &key, h);
        if idx >= 0 {
            let v = self.tables[tid].entries[idx].val;
            if v.tag != VT_NIL {
                return v;
            };
        };
        return v_nil();
    }

    fn table_set(&self, tid: i64, key: Value, val: Value) -> void {
        if key.tag == VT_NIL {
            self.fail_str(STR_PTR("table index is nil"), 19);
            return;
        };
        let h = v_hash(&key);
        let idx = self.t_find(tid, &key, h);
        if idx >= 0 {
            if val.tag == VT_NIL {
                if self.tables[tid].entries[idx].val.tag != VT_NIL {
                    self.tables[tid].dead = self.tables[tid].dead + 1;
                };
                self.tables[tid].entries[idx].val = v_nil();
            } else {
                if self.tables[tid].entries[idx].val.tag == VT_NIL {
                    self.tables[tid].dead = self.tables[tid].dead - 1;
                };
                let nv = value_new(val.tag, val.i, val.f, val.s);
                self.tables[tid].entries[idx].val = nv;
            };
            return;
        };
        if val.tag != VT_NIL {
            self.t_insert(tid, key, val, h);
        };
    }

    fn table_get_str(&self, tid: i64, s: u64) -> Value {
        return self.table_get(tid, v_str(s));
    }

    fn table_set_str(&self, tid: i64, s: u64, val: Value) -> void {
        self.table_set(tid, v_str(s), val);
    }

    fn table_len(&self, tid: i64) -> i64 {
        let n = 0;
        let going = true;
        while going {
            let v = self.table_get(tid, v_int(n + 1));
            if v.tag == VT_NIL {
                going = false;
                continue;
            };
            n = n + 1;
        }
        return n;
    }

    fn table_next(&self, tid: i64, key: Value) -> (Value, Value) {
        if key.tag == VT_NIL {
            return self.t_next_from(tid, 0);
        };
        let h = v_hash(&key);
        let idx = self.t_find(tid, &key, h);
        if idx < 0 {
            return (v_nil(), v_nil());
        };
        return self.t_next_from(tid, idx + 1);
    }

    fn rng_next(&self) -> u64 {
        let x = self.rng0;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        self.rng0 = x;
        self.rng1 = self.rng1 + 6364136223846793005;
        return x ^ (self.rng1 >> 17);
    }

    fn rng_below(&self, n: i64) -> i64 {
        if n <= 1 {
            return 0;
        };
        return (self.rng_next() % (n as u64)) as i64;
    }

    fn fail_str(&self, msg: ptr, n: u64) -> void {
        if self.err == 0 {
            self.err = s_from(msg, n);
        };
        self.ctrl = CTL_ERROR;
    }

    fn take_returns(&self) -> Vec<Value> {
        let out = Vec::new();
        let i = 0;
        while i < (len(self.retvals) as i64) {
            out.push(self.retvals[i]);
            i = i + 1;
        }
        self.retvals = Vec::new();
        return out;
    }
}
