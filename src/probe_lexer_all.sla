fn read_text(path_ptr: ptr, path_len: u64) -> u64 {
    let buf = sa_fs_read_file(path_ptr, path_len, 4194304);
    switch buf {
        0 => {
            return 0;
        },
        default => {},
    };
    return buf;
}

fn lex_file(path_ptr: ptr, path_len: u64) -> void {
    let src = read_text(path_ptr, path_len);
    if src == 0 {
        s_write(s_from(path_ptr, path_len));
        println(" READ_FAIL");
        return;
    };
    let data = SLA_FS_BUFFER_DATA(src);
    let n = SLA_FS_BUFFER_LEN(src);
    let text = s_from(data, n);
    let lx = lex_source(text);
    s_write(s_from(path_ptr, path_len));
    println(" tokens={} err={} line={}", len(lx.toks), lx.err, lx.errline);
    let st = sa_fs_read_buffer_free(src);
}

